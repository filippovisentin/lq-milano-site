---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EventCard from '../components/EventCard.astro';
import Icon from '../components/Icon.astro';
import { getEvents } from '../lib/products';
import { media } from '../lib/media';
import site from '../data/site.json';

// Grouped at build time and re-grouped in the browser, so an event that ends
// after the last deploy still moves to "Eventi passati" on its own.
const events = await getEvents();
---
<Base title="Eventi" description="Eventi e workshop da LQ Milano a NoLo: editoriali di moda dal vivo, live painting, serate. Programma ed eventi passati.">
  <PageHero
    title="Eventi"
    eyebrow="Workshop, serate, editoriali dal vivo"
    lead="Il negozio diventa palcoscenico per giovani creativi, brand emergenti e serate tra amici del vintage."
    image={media.eventsBanner}
    imageAlt="Il negozio LQ Milano allestito, con capi e accessori colorati"
    position="center 60%"
  />

  <section class="section" aria-labelledby="up-title">
    <div class="container">
      <h2 id="up-title">In programma</h2>
      <div class="grid evs" data-upcoming></div>
      <div class="empty" data-up-empty>
        <Icon name="calendar" />
        <div>
          <p><strong>Al momento non ci sono eventi in programma.</strong> I prossimi appuntamenti vengono annunciati su Instagram: seguici per non perderli.</p>
          <div class="empty-cta">
            <a class="btn" href={site.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" class="icon-sm" /> Seguici su Instagram</a>
            <a class="btn btn-ghost" href="/servizi#workshop">Proponi un workshop</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper-2" aria-labelledby="past-title" data-past-section>
    <div class="container">
      <h2 id="past-title">Eventi passati</h2>
      <div class="grid evs" data-past>
        {events.map((e) => <EventCard event={e} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .evs { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .evs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .evs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .evs:empty { display: none; }
  .empty { display: flex; gap: 16px; align-items: flex-start; padding: 24px; border: 1px dashed var(--line-strong); border-radius: 8px; max-width: 760px; }
  .empty > :global(svg) { color: var(--gold-ink); flex: none; }
  .empty-cta { display: flex; flex-wrap: wrap; gap: 10px; }
</style>

<script>
  const up = document.querySelector<HTMLElement>('[data-upcoming]')!;
  const past = document.querySelector<HTMLElement>('[data-past]')!;
  const now = Date.now();
  const cards = [...document.querySelectorAll<HTMLElement>('[data-event]')];
  // upcoming: soonest first; past: most recent first (server order)
  cards
    .filter((c) => new Date(c.dataset.end!).getTime() >= now)
    .reverse()
    .forEach((c) => up.append(c));
  cards.filter((c) => new Date(c.dataset.end!).getTime() < now).forEach((c) => {
    const s = c.querySelector('[data-ev-status]');
    if (s) { s.textContent = 'Concluso'; s.className = 'badge'; }
  });
  document.querySelector<HTMLElement>('[data-up-empty]')!.hidden = up.children.length > 0;
  document.querySelector<HTMLElement>('[data-past-section]')!.hidden = past.children.length === 0;
</script>
