---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { getProduct, listProducts, CATEGORIES, CONDITIONS, imgUrl, has3d, modelBase, productUrl, euro } from '../../../lib/catalog';
export const prerender = false;

const slug = decodeURIComponent(Astro.params.slug ?? '');
const isNew = slug === 'nuovo';
const p = isNew ? null : getProduct(slug);
if (!isNew && !p) return Astro.redirect('/admin/prodotti');
const saved = Astro.url.searchParams.has('salvato');
const warn = Astro.url.searchParams.get('avviso');
const built = Astro.url.searchParams.has('3d');
const photos = (p?.images ?? []).map((im, i) => ({
  ref: `id:${im.id}`, src: imgUrl('products', p!.slug, im, 480),
  front: p!.model3d.front === i, back: p!.model3d.back === i,
}));
const nextOrder = listProducts().length + 1;
---
<Admin title={isNew ? 'Nuovo prodotto' : p!.title} section="prodotti">
  <nav aria-label="Percorso"><ol class="breadcrumb"><li><a href="/admin/prodotti">Prodotti</a></li><li aria-current="page">{isNew ? 'Nuovo' : p!.title}</li></ol></nav>
  <div class="a-title">
    <h1>{isNew ? 'Nuovo prodotto' : p!.title}</h1>
    {!isNew && <a class="btn btn-ghost" href={productUrl(p!.slug)} target="_blank" rel="noopener">Vedi sul sito ↗</a>}
  </div>
  {saved && <p class="notice notice-ok" role="status"><Icon name="check" class="icon-sm" /> Salvato.{built && ' Vista 3D generata.'} Le modifiche sono già online.</p>}
  {warn && <p class="notice" role="status"><Icon name="alert" class="icon-sm" /> {warn}</p>}

  <form class="edit" data-edit novalidate data-slug={p?.slug ?? ''}>
    <input type="hidden" name="slug" value={p?.slug ?? ''} />
    <div class="cols">
      <div class="col-main">
        <section class="a-card" aria-labelledby="ph-t">
          <h2 id="ph-t">Foto</h2>
          <p class="muted small">Per la vista 3D: <strong>fronte</strong> e <strong>retro</strong> su sfondo chiaro e uniforme, capo intero e centrato. Poi aggiungi i dettagli (etichetta, tessuto…). La prima foto è la copertina.</p>
          <ul class="photos" data-photos></ul>
          <label class="drop" data-drop>
            <input type="file" accept="image/*" multiple data-file />
            <Icon name="plus" />
            <span><strong>Aggiungi foto</strong><br /><span class="muted">Trascina qui o tocca per scegliere · JPG, PNG, HEIC fino a 25 MB</span></span>
          </label>
          <p class="field-error" data-photo-err hidden></p>
        </section>

        <section class="a-card" aria-labelledby="info-t">
          <h2 id="info-t">Scheda</h2>
          <div class="grid2">
            <div class="field span2"><label for="title">Nome del capo <span class="req">*</span></label><input class="input" id="title" name="title" required value={p?.title} placeholder="Es. Giacca Pal Zileri" /></div>
            <div class="field"><label for="price">Prezzo (€) <span class="req">*</span></label><input class="input" id="price" name="price" inputmode="decimal" required value={p ? String(p.price).replace('.', ',') : ''} placeholder="85,00" /></div>
            <div class="field"><label for="size">Taglia</label><input class="input" id="size" name="size" value={p?.size ?? ''} placeholder="M, 50, 43…" /></div>
            <div class="field"><label for="category">Categoria</label>
              <select class="select" id="category" name="category">{CATEGORIES.map((c) => <option selected={p?.category === c}>{c}</option>)}</select></div>
            <div class="field"><label for="stato">Stato</label>
              <select class="select" id="stato" name="stato"><option value="">—</option>{CONDITIONS.map((c) => <option selected={p?.details.stato === c}>{c}</option>)}</select></div>
            <div class="field"><label for="anni">Anni / epoca</label><input class="input" id="anni" name="anni" value={p?.details.anni ?? ''} placeholder="'80, '90-2000" /></div>
            <div class="field"><label for="quantity">Pezzi disponibili</label><input class="input" id="quantity" name="quantity" type="number" min="0" max="99" value={p?.quantity ?? 1} /></div>
            <div class="field span2"><label for="description">Descrizione</label><textarea class="textarea" id="description" name="description" rows="5" placeholder="Una riga per frase; lascia una riga vuota tra i paragrafi.">{p?.description}</textarea></div>
            <div class="field"><label for="misure">Misure <span class="muted">(una per riga)</span></label><textarea class="textarea" id="misure" name="misure" rows="5" placeholder={'Larghezza spalle: 45 cm\nLunghezza capo: 69 cm'}>{p?.details.misure.join('\n')}</textarea></div>
            <div class="field"><label for="materiale">Materiale <span class="muted">(una voce per riga)</span></label><textarea class="textarea" id="materiale" name="materiale" rows="5" placeholder="100% lana">{p?.details.materiale.join('\n')}</textarea></div>
          </div>
        </section>
      </div>

      <aside class="col-side">
        <section class="a-card sticky" aria-labelledby="pub-t">
          <h2 id="pub-t">Pubblicazione</h2>
          <label class="switch"><input type="checkbox" name="available" checked={p ? p.available : true} /><span>Disponibile in shop</span></label>
          <p class="muted small">Toglila quando il capo è venduto: resta visibile come “Venduto”.</p>
          <label class="switch"><input type="checkbox" name="featured" checked={p?.featured} /><span>In evidenza in home</span></label>
          <div class="field"><label for="order_n">Posizione nello shop</label><input class="input" id="order_n" name="order_n" type="number" min="1" value={p?.order ?? nextOrder} /><p class="hint">1 = primo.</p></div>
          <button class="btn btn-lg btn-block" type="submit" data-save>Salva</button>
          <p class="hint" data-status role="status" aria-live="polite"></p>
          {!isNew && <button class="btn btn-ghost btn-block danger" type="button" data-delete>Elimina prodotto</button>}
        </section>

        <section class="a-card" aria-labelledby="v3d-t">
          <h2 id="v3d-t">Vista 3D</h2>
          {p && has3d(p) ? (
            <div class="v3d" data-v3d data-base={modelBase(p)} data-version={p.model3d.version} tabindex="0" role="img" aria-label="Anteprima 3D: trascina per ruotare">
              <img src={`${modelBase(p)}/front.webp?v=${p.model3d.version}`} alt="" class="poster" />
            </div>
          ) : (
            <p class="muted small">{isNew ? 'Si genera al salvataggio dalle foto scelte come fronte e retro.' : 'Nessuna vista 3D: scegli fronte e retro tra le foto e salva.'}</p>
          )}
          {p && has3d(p) && (
            <div class="v-btns">
              <button type="button" class="chip" data-face="front">Fronte</button>
              <button type="button" class="chip" data-face="side">Lato</button>
              <button type="button" class="chip" data-face="back">Retro</button>
            </div>
          )}
          <div class="field">
            <label for="tolerance">Sensibilità sfondo: <output data-tol-out>{p?.model3d.tolerance ?? 22}</output></label>
            <input id="tolerance" name="tolerance" type="range" min="8" max="60" step="1" value={p?.model3d.tolerance ?? 22} />
            <p class="hint">Più alta se resta alone di sfondo attorno al capo; più bassa se “mangia” parti chiare del capo.</p>
          </div>
          <label class="switch"><input type="checkbox" name="disable3d" checked={p?.model3d.disabled} /><span>Disattiva il 3D per questo capo</span></label>
          {!isNew && <button class="btn btn-ghost btn-block" type="button" data-regen><Icon name="rotate" class="icon-sm" /> Rigenera 3D e salva</button>}
          {p && <p class="hint">Prezzo attuale online: {euro(p.price)}</p>}
        </section>
      </aside>
    </div>
  </form>
  <script type="application/json" id="photos-data" set:html={JSON.stringify(photos)} />
</Admin>

<style>
  .small { font-size: 0.92rem; }
  .cols { display: grid; gap: 20px; align-items: start; }
  @media (min-width: 1000px) { .cols { grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr); } }
  .col-side { display: grid; gap: 20px; }
  .col-side .a-card + .a-card { margin-top: 0; }
  .grid2 { display: grid; gap: 16px; }
  @media (min-width: 640px) { .grid2 { grid-template-columns: 1fr 1fr; } .span2 { grid-column: span 2; } }
  .photos { list-style: none; margin: 12px 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  :global(.ph-card) { background: #fff; border: 1.5px solid var(--line); border-radius: 10px; overflow: hidden; display: grid; }
  :global(.ph-card.is-front) { border-color: var(--olive); box-shadow: 0 0 0 2px var(--olive); }
  :global(.ph-card.is-back) { border-color: var(--gold-ink); box-shadow: 0 0 0 2px var(--gold); }
  :global(.ph-img) { position: relative; aspect-ratio: 4 / 5; }
  :global(.ph-img img) { width: 100%; height: 100%; object-fit: contain; }
  :global(.ph-n) { position: absolute; top: 6px; left: 6px; background: var(--ink); color: var(--paper); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  :global(.ph-new) { position: absolute; top: 6px; right: 6px; background: var(--gold); color: var(--ink); font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  :global(.ph-roles) { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  :global(.ph-roles label) { display: flex; align-items: center; justify-content: center; gap: 4px; min-height: 40px; font-size: 0.82rem; font-weight: 600; cursor: pointer; }
  :global(.ph-roles label + label) { border-left: 1px solid var(--line); }
  :global(.ph-tools) { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  :global(.ph-tools button) { min-height: 40px; border: 0; background: none; font-size: 1rem; }
  :global(.ph-tools button:hover) { background: var(--paper-2); }
  :global(.ph-tools button:disabled) { opacity: 0.3; }
  :global(.ph-tools .rm:hover) { color: var(--danger); }
  .drop { display: flex; gap: 14px; align-items: center; padding: 18px; border: 2px dashed var(--line-strong); border-radius: 12px; cursor: pointer; transition: background var(--t-fast), border-color var(--t-fast); }
  .drop:hover, .drop:global(.is-over) { background: var(--paper-2); border-color: var(--ink); }
  .drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .drop:focus-within { outline: 3px solid var(--olive); outline-offset: 2px; }
  .switch { display: flex; gap: 10px; align-items: center; min-height: 44px; font-weight: 600; cursor: pointer; }
  .switch input { width: 22px; height: 22px; accent-color: var(--olive); }
  .col-side .field, .col-side .btn { margin-top: 10px; }
  .danger { color: var(--danger); border-color: rgba(163, 39, 27, 0.4); }
  .danger:hover { --bg: #f7e3df; --bd: var(--danger); }
  .v3d { position: relative; aspect-ratio: 1; border-radius: 10px; background: radial-gradient(70% 55% at 50% 40%, #fffdf8, #e7dcc8); cursor: grab; overflow: hidden; }
  .v3d :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .v3d .poster { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; transition: opacity 300ms; }
  .v3d:global(.is-ready) .poster { opacity: 0; }
  .v-btns { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
</style>

<script>
  type Item = { ref: string; src: string; file?: File; front?: boolean; back?: boolean };
  const form = document.querySelector<HTMLFormElement>('[data-edit]')!;
  const list = form.querySelector<HTMLUListElement>('[data-photos]')!;
  const fileIn = form.querySelector<HTMLInputElement>('[data-file]')!;
  const drop = form.querySelector<HTMLElement>('[data-drop]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const saveBtn = form.querySelector<HTMLButtonElement>('[data-save]')!;
  const photoErr = form.querySelector<HTMLElement>('[data-photo-err]')!;
  let items: Item[] = JSON.parse(document.getElementById('photos-data')!.textContent!);
  let front = items.find((i) => i.front)?.ref ?? items[0]?.ref ?? '';
  let back = items.find((i) => i.back)?.ref ?? '';
  const newFiles: File[] = [];
  let dirty = false;

  function render() {
    list.replaceChildren(...items.map((it, i) => {
      const li = document.createElement('li');
      li.className = `ph-card${it.ref === front ? ' is-front' : ''}${it.ref === back ? ' is-back' : ''}`;
      li.innerHTML = `
        <div class="ph-img"><img alt="Foto ${i + 1}" /><span class="ph-n">${i === 0 ? 'Copertina' : i + 1}</span>${it.file ? '<span class="ph-new">Nuova</span>' : ''}</div>
        <div class="ph-roles">
          <label><input type="radio" name="r-front" ${it.ref === front ? 'checked' : ''}> Fronte 3D</label>
          <label><input type="radio" name="r-back" ${it.ref === back ? 'checked' : ''}> Retro 3D</label>
        </div>
        <div class="ph-tools">
          <button type="button" class="l" aria-label="Sposta a sinistra" ${i === 0 ? 'disabled' : ''}>←</button>
          <button type="button" class="r" aria-label="Sposta a destra" ${i === items.length - 1 ? 'disabled' : ''}>→</button>
          <button type="button" class="rm" aria-label="Rimuovi foto">✕</button>
        </div>`;
      li.querySelector('img')!.src = it.src;
      const [rf, rb] = li.querySelectorAll<HTMLInputElement>('input[type=radio]');
      rf.addEventListener('change', () => { front = it.ref; if (back === it.ref) back = ''; touch(); });
      rb.addEventListener('change', () => { back = it.ref; if (front === it.ref) front = items.find((x) => x.ref !== it.ref)?.ref ?? ''; touch(); });
      li.querySelector('.l')!.addEventListener('click', () => { [items[i - 1], items[i]] = [items[i], items[i - 1]]; touch(); });
      li.querySelector('.r')!.addEventListener('click', () => { [items[i + 1], items[i]] = [items[i], items[i + 1]]; touch(); });
      li.querySelector('.rm')!.addEventListener('click', () => {
        items.splice(i, 1);
        if (front === it.ref) front = items[0]?.ref ?? '';
        if (back === it.ref) back = '';
        touch();
      });
      return li;
    }));
  }
  const touch = () => { dirty = true; render(); };
  function addFiles(fs: FileList | File[]) {
    photoErr.hidden = true;
    for (const f of Array.from(fs)) {
      if (!f.type.startsWith('image/') && !/\.(heic|heif)$/i.test(f.name)) { photoErr.textContent = `“${f.name}” non è un’immagine.`; photoErr.hidden = false; continue; }
      if (f.size > 25 * 1024 * 1024) { photoErr.textContent = `“${f.name}” supera 25 MB.`; photoErr.hidden = false; continue; }
      const idx = newFiles.push(f) - 1;
      items.push({ ref: `new:${idx}`, src: URL.createObjectURL(f), file: f });
    }
    if (!front && items[0]) front = items[0].ref;
    if (!back && items[1] && items.length === 2) back = items[1].ref;
    touch();
  }
  fileIn.addEventListener('change', () => { if (fileIn.files) addFiles(fileIn.files); fileIn.value = ''; });
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('is-over')));
  drop.addEventListener('drop', (e) => { e.preventDefault(); if ((e as DragEvent).dataTransfer?.files) addFiles((e as DragEvent).dataTransfer!.files); });
  render();

  const tol = form.querySelector<HTMLInputElement>('#tolerance')!;
  tol.addEventListener('input', () => { form.querySelector('[data-tol-out]')!.textContent = tol.value; });
  form.addEventListener('input', () => { dirty = true; });
  addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

  async function submit(regen: boolean) {
    const title = form.querySelector<HTMLInputElement>('#title')!;
    const price = form.querySelector<HTMLInputElement>('#price')!;
    if (!title.value.trim()) { status.textContent = 'Inserisci il nome del capo.'; title.focus(); return; }
    if (!/^\d+([.,]\d{1,2})?$/.test(price.value.trim())) { status.textContent = 'Prezzo non valido: es. 85 o 85,50.'; price.focus(); return; }
    if (!items.length) { photoErr.textContent = 'Aggiungi almeno una foto.'; photoErr.hidden = false; drop.scrollIntoView({ block: 'center' }); return; }
    const fd = new FormData(form);
    fd.delete('photos');
    newFiles.forEach((f) => fd.append('photos', f, f.name));
    fd.set('order', JSON.stringify(items.map((i) => i.ref)));
    fd.set('front3d', front);
    fd.set('back3d', back);
    if (regen) fd.set('regen3d', '1');
    saveBtn.disabled = true;
    const label = saveBtn.textContent;
    saveBtn.innerHTML = '<span class="spinner" aria-hidden="true"></span> Salvo e genero il 3D…';
    status.textContent = 'Sto elaborando le foto: può richiedere qualche secondo.';
    try {
      const res = await fetch('/api/admin/products', { method: 'POST', body: fd });
      const data = await res.json().catch(() => ({ ok: false, error: 'Risposta non valida dal server.' }));
      if (res.status === 401) { location.href = `/admin/login?next=${encodeURIComponent(location.pathname)}`; return; }
      if (!data.ok) throw new Error(data.error);
      dirty = false;
      const q = new URLSearchParams({ salvato: '1' });
      if (data.built3d) q.set('3d', '1');
      if (data.warning) q.set('avviso', data.warning);
      location.href = `/admin/prodotti/${encodeURIComponent(data.slug)}?${q}`;
    } catch (e) {
      status.textContent = (e as Error).message || 'Salvataggio non riuscito.';
      saveBtn.disabled = false;
      saveBtn.textContent = label;
    }
  }
  form.addEventListener('submit', (e) => { e.preventDefault(); submit(false); });
  form.querySelector('[data-regen]')?.addEventListener('click', () => submit(true));
  form.querySelector('[data-delete]')?.addEventListener('click', async () => {
    const title = form.querySelector<HTMLInputElement>('#title')!.value;
    if (!confirm(`Eliminare definitivamente “${title}”? Foto e vista 3D verranno cancellate.`)) return;
    const res = await fetch(`/api/admin/products/${encodeURIComponent(form.dataset.slug!)}`, { method: 'DELETE' });
    if (res.ok) { dirty = false; location.href = `/admin/prodotti?eliminato=${encodeURIComponent(title)}`; }
    else status.textContent = 'Eliminazione non riuscita.';
  });

  // 3D preview
  const v = document.querySelector<HTMLElement>('[data-v3d]');
  if (v) {
    import('../../../scripts/garment-viewer').then(async ({ mountViewer }) => {
      const h = await mountViewer(v, { base: v.dataset.base!, version: v.dataset.version });
      v.classList.add('is-ready');
      document.querySelectorAll<HTMLButtonElement>('[data-face]').forEach((b) => b.addEventListener('click', () => { h.setAuto(false); h.face(b.dataset.face as 'front'); }));
    }).catch(() => {});
  }
</script>
