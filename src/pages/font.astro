---
// Font proposals for LQ, shown on real site content with the green/violet
// palette. Not linked from the menu. Pick one with the buttons or ?set=<id>.
import '../styles/global.css';
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/martian-mono';
import '@fontsource/gloock';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/sometype-mono';
import '@fontsource-variable/darker-grotesque';
import '@fontsource-variable/familjen-grotesk';
import '@fontsource-variable/funnel-display';
import '@fontsource-variable/host-grotesk';
import NeonLogo from '../components/NeonLogo.astro';
import { media } from '../lib/media';

const sets = [
  { id: 'insegna', name: 'A · Insegna', why: 'Titoli come le insegne dipinte dei negozi: alti, stretti, un po’ industriali. Etichette in un mono largo, da cartellino.', fonts: 'Big Shoulders Display · Schibsted Grotesk · Martian Mono' },
  { id: 'archivio', name: 'B · Archivio', why: 'Un serif pesante e morbido che richiama la L e la Q del logo, ma non è il solito Bodoni/Playfair. Corpo pulito, etichette mono da archivio.', fonts: 'Gloock · Hanken Grotesk · Sometype Mono' },
  { id: 'bottega', name: 'C · Bottega', why: 'Grottesco stretto e scuro con un disegno irregolare, molto “fatto a mano”. Corpo svedese con carattere, etichette mono.', fonts: 'Darker Grotesque · Familjen Grotesk · Martian Mono' },
  { id: 'galleria', name: 'D · Galleria', why: 'Display recente e poco visto, geometrico con tagli netti. Corpo neutro ma non Inter, etichette spaziate come MILANO.', fonts: 'Funnel Display · Host Grotesk · Jost' },
  { id: 'attuale', name: 'Attuale', why: 'Per confronto: Archivio extra-condensato, Archivo, Jost.', fonts: 'Archivo (LQ Display) · Archivo · Jost' },
];
const store = media.storefront.src;
---
<!doctype html>
<html lang="it" class="js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Font · LQ Milano</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="fp" data-set="insegna">
    <nav class="picker" aria-label="Proposte di font">
      {sets.map((s, i) => <button type="button" data-id={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.name}</button>)}
    </nav>
    {sets.map((s) => (
      <p class="why" data-for={s.id}><b>{s.fonts}</b><br />{s.why}</p>
    ))}

    <section class="hero" style={`--img:url('${store}')`}>
      <div class="hero-in">
        <p class="lbl on">Via Giulio e Corrado Venini 54 · NoLo, Milano</p>
        <h1 class="disp">Pezzi unici,<br /><em>scelti a mano</em></h1>
        <p class="lead">Vintage e designer dagli anni ’60 ai primi 2000. Ogni capo è misurato, fotografato e descritto da noi.</p>
        <div class="row"><a class="btn btn-gold" href="#">Entra nello shop</a><a class="btn btn-ghost" href="#">Il negozio</a></div>
      </div>
    </section>

    <section class="wrap">
      <p class="lbl">Nuovi arrivi · 23 capi</p>
      <h2 class="disp h2">Questa settimana</h2>
      <div class="grid">
        {[['Cappotto Schneiders Salzburg', '140,00 €', 'Taglia 52', 'Anni ’80'], ['Bomber Hartwell Sports', '65,00 €', 'Taglia M', 'Anni ’80'], ['Giacca Yohji Yamamoto', '420,00 €', 'Taglia 3', 'Anni ’90']].map(([t, p, s, e], i) => (
          <article class="card">
            <div class="ph" style={i === 0 ? `background-image:url('${store}')` : ''}></div>
            <h3>{t}</h3>
            <p class="meta"><span class="price">{p}</span><span class="lbl">{s}</span><span class="lbl">{e}</span></p>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap two">
      <div>
        <p class="lbl">Scheda prodotto</p>
        <h2 class="disp h2">Giacca Yohji Yamamoto</h2>
        <p class="body">Lana nera, taglio ampio, spalla scesa. Piccolo segno d’uso sul polsino sinistro, visibile nella quarta foto. Misure prese a capo steso.</p>
        <dl class="facts">
          <div><dt class="lbl">Spalle</dt><dd>48 cm</dd></div>
          <div><dt class="lbl">Petto</dt><dd>62 cm</dd></div>
          <div><dt class="lbl">Lunghezza</dt><dd>78 cm</dd></div>
          <div><dt class="lbl">Condizioni</dt><dd>Ottimo</dd></div>
        </dl>
        <a class="btn" href="#">Aggiungi al carrello</a>
      </div>
      <div class="night-box">
        <NeonLogo size="lg" />
        <p class="disp h2 on">Aperto oggi<br />fino alle 19:30</p>
        <p class="lbl on">01 L’ingresso · 02 Il corridoio · 03 La sala · 04 Il retro</p>
      </div>
    </section>

    <script>
      const body = document.body;
      const pick = (id: string) => {
        body.dataset.set = id;
        document.querySelectorAll<HTMLButtonElement>('.picker button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === id)));
      };
      document.querySelectorAll<HTMLButtonElement>('.picker button').forEach((b) => b.addEventListener('click', () => pick(b.dataset.id!)));
      const q = new URLSearchParams(location.search).get('set');
      if (q) pick(q);
    </script>

    <style is:global>
      .fp { margin: 0; background: var(--paper); color: var(--ink); }
      .fp[data-set='insegna'] { --f-d: 'Big Shoulders Display Variable'; --w-d: 900; --tt-d: uppercase; --ls-d: 0.005em; --lh-d: 0.86; --f-b: 'Schibsted Grotesk Variable'; --f-l: 'Martian Mono Variable'; --ls-l: 0.04em; --fs-l: 0.7rem; }
      .fp[data-set='archivio'] { --f-d: 'Gloock'; --w-d: 400; --tt-d: none; --ls-d: -0.02em; --lh-d: 0.95; --f-b: 'Hanken Grotesk Variable'; --f-l: 'Sometype Mono Variable'; --ls-l: 0.06em; --fs-l: 0.76rem; }
      .fp[data-set='bottega'] { --f-d: 'Darker Grotesque Variable'; --w-d: 900; --tt-d: uppercase; --ls-d: -0.01em; --lh-d: 0.78; --f-b: 'Familjen Grotesk Variable'; --f-l: 'Martian Mono Variable'; --ls-l: 0.04em; --fs-l: 0.7rem; }
      .fp[data-set='galleria'] { --f-d: 'Funnel Display Variable'; --w-d: 800; --tt-d: none; --ls-d: -0.035em; --lh-d: 0.92; --f-b: 'Host Grotesk Variable'; --f-l: 'Jost Variable'; --ls-l: 0.2em; --fs-l: 0.74rem; }
      .fp[data-set='attuale'] { --f-d: 'LQ Display'; --w-d: 900; --tt-d: uppercase; --ls-d: 0; --lh-d: 0.88; --f-b: 'Archivo Variable'; --f-l: 'Jost Variable'; --ls-l: 0.16em; --fs-l: 0.74rem; }
      .fp, .fp .body, .fp .lead, .fp h3, .fp dd, .fp .btn { font-family: var(--f-b), sans-serif; }
      .fp .disp { font-family: var(--f-d), sans-serif; font-weight: var(--w-d); text-transform: var(--tt-d); letter-spacing: var(--ls-d); line-height: var(--lh-d); margin: 0 0 var(--s-5); }
      .fp .disp em { font-style: normal; color: var(--accent); }
      .fp .hero .disp em, .fp .night-box .disp em { color: var(--neon); }
      .fp .lbl { font-family: var(--f-l), monospace; font-size: var(--fs-l); letter-spacing: var(--ls-l); text-transform: uppercase; font-weight: 500; color: var(--ink-2); margin: 0 0 var(--s-3); }
      .fp .lbl.on { color: var(--on-night-2); }
      .fp .price { font-family: var(--f-l), monospace; font-weight: 600; font-size: 0.9rem; }
      .picker { position: sticky; top: 0; z-index: 5; display: flex; gap: 6px; flex-wrap: wrap; padding: 10px var(--gutter); background: var(--night); }
      .picker button { font: 600 0.85rem var(--font-body); padding: 9px 14px; border-radius: 999px; border: 1px solid rgba(242, 239, 232, 0.3); background: transparent; color: var(--on-night); cursor: pointer; }
      .picker button[aria-pressed='true'] { background: var(--neon); border-color: var(--neon); color: var(--night); }
      .why { display: none; margin: 0; padding: 14px var(--gutter); background: var(--violet-50); border-bottom: 1px solid var(--line); font: 0.95rem/1.5 var(--font-body); }
      .fp[data-set='insegna'] .why[data-for='insegna'], .fp[data-set='archivio'] .why[data-for='archivio'], .fp[data-set='bottega'] .why[data-for='bottega'], .fp[data-set='galleria'] .why[data-for='galleria'], .fp[data-set='attuale'] .why[data-for='attuale'] { display: block; }
      .hero { background: linear-gradient(rgba(20, 18, 27, 0.7), rgba(20, 18, 27, 0.92)), var(--img) center / cover; color: var(--on-night); }
      .hero-in { max-width: var(--max); margin: 0 auto; padding: var(--s-9) var(--gutter) var(--s-8); }
      .hero h1 { font-size: clamp(3.4rem, 1.6rem + 8vw, 8.5rem); }
      .lead { max-width: 52ch; font-size: 1.15rem; line-height: 1.55; margin: 0 0 var(--s-6); }
      .row { display: flex; gap: var(--s-3); flex-wrap: wrap; }
      .hero .btn-ghost { --fg: var(--on-night); --bd: rgba(242, 239, 232, 0.45); }
      .wrap { max-width: var(--max); margin: 0 auto; padding: var(--s-8) var(--gutter); }
      .h2 { font-size: clamp(2.4rem, 1.4rem + 4vw, 4.6rem); }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--s-5); }
      .card .ph { aspect-ratio: 3 / 4; background: var(--tile) center / cover; border-radius: var(--radius); margin-bottom: var(--s-3); }
      .card h3 { font-size: 1.05rem; font-weight: 600; text-transform: none; letter-spacing: 0; line-height: 1.3; margin: 0 0 6px; }
      .meta { display: flex; gap: 14px; align-items: baseline; margin: 0; }
      .meta .lbl { margin: 0; }
      .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--s-7); align-items: start; }
      .body { font-size: 1.08rem; line-height: 1.6; max-width: 56ch; }
      .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin: var(--s-5) 0 var(--s-6); }
      .facts div { padding: 12px 0; border-top: 1px solid var(--line); }
      .facts dt { margin: 0 0 4px; } .facts dd { margin: 0; font-size: 1.1rem; font-weight: 600; }
      .night-box { background: var(--night); color: var(--on-night); padding: var(--s-7) var(--s-6); border-radius: var(--radius-card); }
      .night-box .h2 { margin-top: var(--s-6); }
    </style>
  </body>
</html>
