---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { listProducts, CATEGORIES, SHOW_3D } from '../lib/catalog';

export const prerender = false;
const products = listProducts();
const usedCats = CATEGORIES.filter((c) => products.some((p) => p.category === c));
const sizeOrder = (s: string) => {
  const letters = ['XXS', 'XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL'];
  const i = letters.indexOf(s.toUpperCase());
  return i >= 0 ? i : 100 + Number.parseFloat(s) || 999;
};
const sizes = [...new Set(products.map((p) => p.size).filter(Boolean) as string[])].sort((a, b) => sizeOrder(a) - sizeOrder(b));
const PAGE = 12;
const inStockCount = products.filter((p) => p.available && p.quantity > 0).length;
const catCount = (c: string) => products.filter((p) => p.category === c).length;
---
<Base title="Shop" description={`Shop online di LQ Milano: ${products.length} capi vintage selezionati a mano, dagli anni ’60 ai 2000. Pezzi unici con misure e stato verificati.`}>
  <header class="shop-head night">
    <div class="container">
      <nav aria-label="Percorso"><ol class="breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Shop</li></ol></nav>
      <div class="head-row">
        <h1 class="shop-title">Shop</h1>
        <div class="head-side">
          <p class="head-count"><span class="dot" aria-hidden="true"></span> <span class="tabular">{inStockCount}</span> capi disponibili · pezzi unici</p>
          <p class="head-lead">Capi vintage selezionati a mano a NoLo, dagli anni ’60 ai primi 2000. Misure, materiale e stato sono indicati in ogni scheda.</p>
        </div>
      </div>
      {SHOW_3D && <p class="hint-3d"><Icon name="cube" class="icon-sm" /> I capi con il badge <strong>3D</strong> si possono ruotare a 360°.</p>}
    </div>
  </header>

  <div class="container shop" data-shop data-page-size={PAGE}>
    <form class="tools" role="search" aria-label="Cerca e filtra i capi" data-tools onsubmit="return false">
      <div class="search">
        <label for="q" class="sr-only">Cerca nello shop</label>
        <Icon name="search" class="icon-sm" />
        <input id="q" name="q" class="input" type="search" placeholder="Cerca un capo, un brand…" autocomplete="off" enterkeyhint="search" />
      </div>
      <div class="filter-row">
        <div class="chips" role="group" aria-label="Categoria">
          <button type="button" class="tab" data-cat="" aria-pressed="true">Tutto <sup class="tabular">{products.length}</sup></button>
          {usedCats.map((c) => <button type="button" class="tab" data-cat={c} aria-pressed="false">{c} <sup class="tabular">{catCount(c)}</sup></button>)}
        </div>
        <div class="selects">
          <label class="sel">
            <span class="sr-only">Taglia</span>
            <select class="select" name="size" data-size>
              <option value="">Tutte le taglie</option>
              {sizes.map((s) => <option value={s}>Taglia {s}</option>)}
            </select>
          </label>
          <label class="sel">
            <span class="sr-only">Ordina per</span>
            <select class="select" name="sort" data-sort>
              <option value="">In evidenza</option>
              <option value="price-asc">Prezzo crescente</option>
              <option value="price-desc">Prezzo decrescente</option>
              <option value="name">Nome A–Z</option>
            </select>
          </label>
        </div>
      </div>
    </form>

    <div class="count-row">
      <p class="count" role="status" aria-live="polite" data-count>{products.length} capi</p>
      <div class="view" role="group" aria-label="Vista">
        <button type="button" class="view-btn" data-view="grid" aria-pressed="true">Griglia</button>
        <button type="button" class="view-btn" data-view="large" aria-pressed="false">Grande</button>
      </div>
    </div>

    <div class="grid products" data-grid>
      {products.map((p, i) => <ProductCard product={p} eager={i < 4} headingLevel="h2" />)}
    </div>

    <div class="empty" data-empty hidden>
      <p class="h3">Nessun capo corrisponde alla ricerca.</p>
      <p class="muted">Prova un altro termine o togli qualche filtro. Cerchi qualcosa di preciso? Scrivici: arrivano capi nuovi in negozio ogni settimana.</p>
      <button type="button" class="btn btn-ghost" data-reset>Azzera filtri</button>
    </div>

    <div class="more" data-more-wrap>
      <p class="muted tabular" data-progress></p>
      <button type="button" class="btn btn-ghost btn-lg" data-more>Mostra altri capi</button>
    </div>
  </div>
</Base>

<style>
  .shop-head { position: relative; overflow: hidden; isolation: isolate; padding: 18px 0 clamp(28px, 4vw, 48px); }
  .shop-head::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(40% 90% at 18% 70%, rgba(255, 91, 36, 0.2), transparent 70%); }
  .shop-head .breadcrumb { color: var(--on-night-2); }
  .head-row { display: grid; gap: 18px 48px; align-items: end; }
  .shop-title { font-size: clamp(5rem, 2.4rem + 13vw, 15rem); line-height: 0.78; margin: 0; }
  .head-side { display: grid; gap: 10px; max-width: 46ch; padding-bottom: 8px; }
  .head-count { display: inline-flex; align-items: center; gap: 10px; margin: 0; font: 500 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.03em; color: var(--on-night); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--neon); box-shadow: 0 0 10px var(--neon-glow); }
  .head-lead { margin: 0; color: var(--on-night-2); }
  @media (min-width: 900px) { .head-row { grid-template-columns: auto 1fr; } }
  .hint-3d { display: inline-flex; gap: 8px; align-items: center; margin: 16px 0 0; font-size: 0.92rem; color: var(--on-night-2); }
  .shop { padding-bottom: clamp(56px, 8vw, 112px); }
  .tools {
    position: sticky; top: var(--header-h); z-index: 5; margin: 0 calc(var(--gutter) * -1); padding: 10px var(--gutter);
    background: rgba(247, 243, 234, 0.96); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line-strong); display: grid; gap: 12px;
  }
  .search { position: relative; }
  .search :global(svg) { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--ink-2); pointer-events: none; }
  .search .input { padding-left: 34px; border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; background: transparent; font-size: 0.98rem; }
  .search .input:focus { box-shadow: none; border-bottom-color: var(--neon); }
  .search :global(svg) { left: 4px !important; }
  .filter-row { display: grid; gap: 10px; }
  .chips { display: flex; gap: 22px; overflow-x: auto; padding: 2px; margin: -2px; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .tab { flex: none; display: inline-flex; align-items: center; gap: 4px; min-height: 44px; padding: 0; border: 0; background: none; color: var(--ink-2); font: 500 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.03em; border-bottom: 2px solid transparent; white-space: nowrap; }
  .tab sup { font-size: 0.68rem; color: var(--ink-2); top: -0.5em; }
  .tab:hover { color: var(--ink); }
  .tab[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--neon); }
  .tab[aria-pressed='true'] sup { color: var(--neon-ink); }
  .selects .select { border-radius: 2px; font: 500 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.02em; min-height: 44px; background-color: transparent; }
  @media (max-width: 899px) { .selects .select { font-size: 0.72rem; letter-spacing: 0; padding-left: 10px; padding-right: 30px; background-position: right 8px center; } }
  .selects { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  @media (min-width: 900px) {
    .tools { grid-template-columns: minmax(240px, 420px) 1fr; align-items: center; gap: 4px 24px; }
    .filter-row { display: contents; }
    .selects { grid-column: 2; grid-row: 1; justify-self: end; }
    .chips { grid-column: 1 / -1; grid-row: 2; }
    .selects { grid-template-columns: auto auto; }
    .select { min-width: 190px; }
  }
  .count-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 14px 0 18px; }
  .count { margin: 0; color: var(--ink-2); font: 500 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.03em; }
  .view { display: flex; gap: 16px; }
  .view-btn { min-height: 44px; padding: 0; border: 0; background: none; color: var(--ink-2); font: 500 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.03em; border-bottom: 2px solid transparent; }
  .view-btn[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--ink); }
  .products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
  @media (max-width: 339px) { .products { grid-template-columns: 1fr; } }
  @media (min-width: 640px) { .products { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 20px; } }
  @media (min-width: 1100px) { .products { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 44px 24px; } }
  .products.is-large { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .products.is-large { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 24px; } }
  .products :global([data-product][hidden]) { display: none; }
  .empty { padding: 48px 0; max-width: 52ch; }
  .more { display: grid; justify-items: center; gap: 10px; margin-top: 48px; }
  .more p { margin: 0; font-size: 0.92rem; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-shop]')!;
  const PAGE = Number(root.dataset.pageSize);
  const grid = root.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
  const q = root.querySelector<HTMLInputElement>('#q')!;
  const sizeSel = root.querySelector<HTMLSelectElement>('[data-size]')!;
  const sortSel = root.querySelector<HTMLSelectElement>('[data-sort]')!;
  const catBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const countEl = root.querySelector<HTMLElement>('[data-count]')!;
  const moreWrap = root.querySelector<HTMLElement>('[data-more-wrap]')!;
  const moreBtn = root.querySelector<HTMLButtonElement>('[data-more]')!;
  const progress = root.querySelector<HTMLElement>('[data-progress]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;

  const params = new URLSearchParams(location.search);
  let state = {
    q: params.get('q') ?? '',
    cat: params.get('cat') ?? '',
    size: params.get('taglia') ?? '',
    sort: params.get('ordina') ?? '',
    shown: Math.max(PAGE, Number(params.get('n')) || PAGE),
  };
  q.value = state.q; sizeSel.value = state.size; sortSel.value = state.sort;

  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function apply(pushScroll = false) {
    catBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.cat ?? '') === state.cat)));
    const terms = norm(state.q).split(/\s+/).filter(Boolean);
    let list = cards.filter((c) => {
      const d = c.dataset;
      if (state.cat && d.category !== state.cat) return false;
      if (state.size && d.size !== state.size) return false;
      if (terms.length && !terms.every((t) => norm(d.title! + ' ' + d.category).includes(t))) return false;
      return true;
    });
    const by = {
      'price-asc': (a: HTMLElement, b: HTMLElement) => +a.dataset.price! - +b.dataset.price!,
      'price-desc': (a: HTMLElement, b: HTMLElement) => +b.dataset.price! - +a.dataset.price!,
      name: (a: HTMLElement, b: HTMLElement) => a.dataset.title!.localeCompare(b.dataset.title!, 'it'),
    }[state.sort] ?? ((a: HTMLElement, b: HTMLElement) => +a.dataset.order! - +b.dataset.order!);
    // sold pieces go last, but stay visible
    list.sort((a, b) => +b.dataset.available! - +a.dataset.available! || by(a, b));
    cards.forEach((c) => (c.hidden = true));
    list.forEach((c, i) => { grid.append(c); c.hidden = i >= state.shown; });
    const n = list.length;
    countEl.textContent = n === cards.length && !state.q && !state.cat && !state.size ? `${n} capi` : `${n} ${n === 1 ? 'capo trovato' : 'capi trovati'}`;
    empty.hidden = n > 0;
    moreWrap.hidden = n <= state.shown;
    progress.textContent = `Stai vedendo ${Math.min(n, state.shown)} di ${n}`;
    const p = new URLSearchParams();
    if (state.q) p.set('q', state.q);
    if (state.cat) p.set('cat', state.cat);
    if (state.size) p.set('taglia', state.size);
    if (state.sort) p.set('ordina', state.sort);
    if (state.shown > PAGE) p.set('n', String(state.shown));
    const url = `${location.pathname}${p.size ? `?${p}` : ''}`;
    history.replaceState(history.state, '', url);
    try { sessionStorage.setItem('lq-shop-url', url); } catch {}
  }

  let t: number;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { state.q = q.value.trim(); state.shown = PAGE; apply(); }, 160); });
  sizeSel.addEventListener('change', () => { state.size = sizeSel.value; state.shown = PAGE; apply(); });
  sortSel.addEventListener('change', () => { state.sort = sortSel.value; apply(); });
  catBtns.forEach((b) => b.addEventListener('click', () => { state.cat = b.dataset.cat ?? ''; state.shown = PAGE; apply(); }));
  moreBtn.addEventListener('click', () => {
    const firstNew = state.shown;
    state.shown += PAGE; apply();
    // move focus to the first newly shown product for keyboard/screen-reader users
    const visible = cards.filter((c) => !c.hidden);
    (visible[firstNew]?.querySelector('a') as HTMLElement | null)?.focus({ preventScroll: true });
  });
  root.querySelector('[data-reset]')!.addEventListener('click', () => {
    state = { q: '', cat: '', size: '', sort: '', shown: PAGE };
    q.value = ''; sizeSel.value = ''; sortSel.value = '';
    apply();
  });

  // grid / large view, remembered per visitor
  const viewBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const setView = (v: string) => {
    grid.classList.toggle('is-large', v === 'large');
    // bigger slots need bigger files: keep photos sharp in the large view
    grid.querySelectorAll<HTMLImageElement>('.card-media img').forEach((img) => {
      img.dataset.sizes ??= img.sizes;
      img.sizes = v === 'large' ? '(min-width: 1440px) 700px, (min-width: 640px) 48vw, 100vw' : img.dataset.sizes;
    });
    viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
    try { localStorage.setItem('lq-shop-view', v); } catch {}
  };
  viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
  try { const v = localStorage.getItem('lq-shop-view'); if (v) setView(v); } catch {}

  apply();
  // restore scroll position when coming back from a product page
  try {
    const y = sessionStorage.getItem('lq-shop-y');
    if (y && (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming)?.type === 'back_forward') scrollTo(0, Number(y));
    addEventListener('pagehide', () => sessionStorage.setItem('lq-shop-y', String(scrollY)));
  } catch {}
</script>
