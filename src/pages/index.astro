---
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro';
import NeonLogo from '../components/NeonLogo.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Tbc from '../components/Tbc.astro';
import { listProducts, listEvents, inStock, isPast, eventUrl, fmtDay, fmtMonth, fmtTime } from '../lib/catalog';
import { media, rooms } from '../lib/media';
import site from '../data/site.json';

export const prerender = false;
const products = listProducts().filter(inStock);
const newest = [...products].sort((a, b) => b.createdAt.localeCompare(a.createdAt)).slice(0, 8);
const events = listEvents();
const upcoming = events.filter((e) => !isPast(e)).reverse();
const shownEvents = (upcoming.length ? upcoming : events).slice(0, 4);

// brand names that actually pass through the shop and the archive
const brands = ['Hermès', 'Saint Laurent', 'Yohji Yamamoto', 'Junya Watanabe · Comme des Garçons', 'Versace Jeans Couture', 'Valentino', 'Moschino', 'Trussardi', 'Armani Jeans', 'Antonio Marras', 'Sergio Tacchini', 'Pal Zileri', 'Iceberg', 'Costume National', 'Americanino', 'Hamilton'];
const services = [
  { id: 'consulenza-moda', title: 'Consulenza moda', text: 'Campagne vendita e consulenze stilistiche per brand emergenti e affermati, con Lea Quattrocchi.' },
  { id: 'noleggio', title: 'Noleggio per il set', text: 'Capi e accessori di tutte le epoche per cinema, teatro, shooting e video.' },
  { id: 'upcycling', title: 'Upcycling e sartoria', text: 'Capi vintage rifatti con tessuti di recupero, nel laboratorio del negozio.' },
  { id: 'workshop', title: 'Eventi e workshop', text: 'Uno spazio nel negozio per artisti e brand emergenti.' },
];
const dev = import.meta.env.DEV;
const aboutAntonio = 'Antonio cerca i capi uomo: per lui moda e musica vanno insieme.';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Home">
  <div class="home">
    <!-- ============ HERO ============ -->
    <section class="hero night" aria-labelledby="hero-title">
      <figure class="hero-bg" aria-hidden="true">
        <Pic src={media.storefront} alt="" sizes="(min-width: 1000px) 66vw, 100vw" loading="eager" fetchpriority="high" />
      </figure>
      <div class="hero-copy">
        <!-- photo-only hero: the title stays for screen readers and search engines -->
        <h1 id="hero-title" class="sr-only">LQ Milano Vintage, concept store a {site.address.area}, Milano</h1>
        <p class="hero-line">Vintage uomo e donna dagli anni ’60 ai 2000. Scelto, misurato e fotografato da noi, a NoLo.</p>
        <div class="hero-cta">
          <a class="btn btn-neon" href="/shop">Entra nello shop <Icon name="arrow" class="icon-sm" /></a>
          <a class="btn btn-ghost" href="/concept-store">Vieni in via Venini</a>
        </div>
      </div>
      <div class="hero-foot">
        <span><Icon name="pin" class="icon-sm" /> {site.address.street} · {site.address.area}</span>
        <a href="/shop" class="tabular"><span class="dot" aria-hidden="true"></span> {products.length} capi online · in negozio ce ne sono molti di più</a>
        <span class="hero-cap">Nella foto: la vetrina di via Venini</span>
        <a href="#new-title" class="hero-scroll">Scorri ↓</a>
      </div>
    </section>

    <!-- ============ 01 APPENA ARRIVATI ============ -->
    <section class="block" aria-labelledby="new-title">
      <header class="head">
        <p class="label"><span class="idx">01</span> Nuovi arrivi</p>
        <h2 id="new-title" class="display">Questa <em>settimana</em></h2>
        <a class="link-arrow" href="/shop"><span>Vedi tutti i {products.length} capi</span><Icon name="arrow" class="icon-sm" /></a>
      </header>
      <ul class="arrivals" role="list">
        {newest.map((p, i) => <li class="reveal" style={`--i:${i % 4}`}><ProductCard product={p} eager={i < 2} /></li>)}
      </ul>
    </section>

    <!-- ============ 02 SERVIZI ============ -->
    <section class="block" aria-labelledby="svc-title">
      <header class="head">
        <p class="label"><span class="idx">02</span> Oltre lo shop</p>
        <h2 id="svc-title" class="display">Noleggio, sartoria, <em>consulenza</em></h2>
        <a class="link-arrow" href="/servizi"><span>Tutti i servizi</span><Icon name="arrow" class="icon-sm" /></a>
      </header>
      <ul class="svc-list" role="list">
        {services.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href={`/servizi#${s.id}`} class="svc row-press">
              <span class="tile-n tabular">{pad(i + 1)}</span>
              <span class="svc-t">{s.title}</span>
              <span class="svc-d">{s.text}</span>
              <Icon name="arrow" class="icon-sm svc-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============ 03 IL NEGOZIO ============ -->
    <section class="block" aria-labelledby="rooms-title">
      <header class="head">
        <p class="label"><span class="idx">03</span> Il negozio</p>
        <h2 id="rooms-title" class="display">Quattro stanze <em>in via Venini</em></h2>
        <a class="link-arrow" href="/concept-store"><span>Fai il giro</span><Icon name="arrow" class="icon-sm" /></a>
      </header>
      <ol class="tiles rooms" role="list">
        {rooms.map((r, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href={`/concept-store#${r.id}`} class="tile">
              <span class="tile-img"><Pic src={r.img} alt={r.alt} sizes="(min-width: 1100px) 24vw, 50vw" /></span>
              <span class="tile-row"><span class="tile-n tabular">{pad(i + 1)}</span><span class="tile-t">{r.title}</span></span>
              {r.tag && <span class="tile-tag">{r.tag}</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ 04 LE PERSONE ============ -->
    <section class="block people" aria-labelledby="people-title">
      <figure class="people-img reveal">
        <Pic src={media.lea} alt="Lea Quattrocchi, titolare di LQ Milano" sizes="(min-width: 900px) 40vw, 100vw" />
      </figure>
      <div class="people-copy">
        <p class="label"><span class="idx">04</span> Le persone</p>
        <h2 id="people-title" class="sr-only">Le persone di LQ Milano</h2>
        <div class="quote reveal">
          <p>{dev ? <>A NoLo dal <Tbc q="anno di apertura a NoLo">[anno]</Tbc>. Ci passano artisti, costumisti e chi cerca un capo che non trova altrove.</> : <>A NoLo, in via Venini. Ci passano artisti, costumisti e chi cerca un capo che non trova altrove.</>}</p>
          <p class="who"><strong>Lea Quattrocchi</strong> · titolare, campagne vendita ed eventi</p>
        </div>
        <div class="quote reveal">
          <p>{aboutAntonio}</p>
          <p class="who"><strong>Antonio Casale</strong> · stylist e ricercatore, selezione uomo</p>
        </div>
        <a class="link-arrow" href="/chi-siamo"><span>Le loro storie</span><Icon name="arrow" class="icon-sm" /></a>
      </div>
    </section>

    <!-- ============ 05 INDICE DEI MARCHI ============ -->
    <section class="block brands" aria-labelledby="brands-title">
      <header class="head">
        <p class="label"><span class="idx">05</span> Dall’archivio</p>
        <h2 id="brands-title" class="display">Passati <em>di qui</em></h2>
        <a class="link-arrow" href="/galleria"><span>Guarda la galleria</span><Icon name="arrow" class="icon-sm" /></a>
      </header>
      <ul class="brand-list" role="list">
        {brands.map((b) => <li>{b}</li>)}
      </ul>
    </section>

    <!-- ============ 06 EVENTI ============ -->
    <section class="block" aria-labelledby="ev-title">
      <header class="head">
        <p class="label"><span class="idx">06</span> Eventi e workshop</p>
        <h2 id="ev-title" class="display">{upcoming.length ? <>In <em>programma</em></> : <>Il negozio <em>come palco</em></>}</h2>
        <a class="link-arrow" href="/eventi"><span>Tutti gli eventi</span><Icon name="arrow" class="icon-sm" /></a>
      </header>
      {!upcoming.length && <p class="head-note ev-note">Calendario in preparazione: lo annunciamo prima su <a href={site.social.instagram} target="_blank" rel="noopener">Instagram<span class="sr-only"> (si apre in una nuova scheda)</span></a>. Intanto, gli ultimi eventi.</p>}
      <ol class="ev-list" role="list">
        {shownEvents.map((e) => {
          const d = new Date(e.start);
          const past = isPast(e);
          return (
            <li>
              <a class="ev-row row-press" href={eventUrl(e.slug)}>
                <time class="ev-date tabular" datetime={d.toISOString()}><span class="d">{fmtDay(d)}</span><span class="m">{fmtMonth(d)}</span></time>
                <span class="ev-main"><span class="ev-t">{e.title}</span><span class="ev-meta">{fmtTime(d)} · {e.venue}</span></span>
                <span class:list={['ev-status', !past && e.registration === 'aperta' && 'is-open']}>{past ? 'Concluso' : e.registration === 'aperta' ? 'Iscrizioni aperte' : e.registration === 'esaurita' ? 'Posti esauriti' : 'Iscrizioni chiuse'}</span>
                <Icon name="arrow" class="icon-sm ev-arrow" />
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- ============ VISITA ============ -->
    <section class="visit night" aria-labelledby="visit-title">
      <div class="visit-copy">
        <NeonLogo size="md" />
        <h2 id="visit-title" class="display">Vieni a <em>trovarci</em></h2>
        <address>{site.address.street}<br />{site.address.postcode} {site.address.city} · {site.address.area}</address>
        <div class="visit-cta">
          <a class="btn btn-neon" href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" class="icon-sm" /> Indicazioni<span class="sr-only"> (si apre in una nuova scheda)</span></a>
          <a class="btn btn-ghost" href={site.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" class="icon-sm" /> WhatsApp<span class="sr-only"> (si apre in una nuova scheda)</span></a>
          <a class="btn btn-ghost" href={site.phoneHref}><Icon name="phone" class="icon-sm" /> Chiama</a>
        </div>
        <p class="social label">
          <a href={site.social.instagram} target="_blank" rel="noopener">Instagram<span class="sr-only"> (si apre in una nuova scheda)</span></a>
          <a href={site.social.tiktok} target="_blank" rel="noopener">TikTok<span class="sr-only"> (si apre in una nuova scheda)</span></a>
          <a href={site.social.vinted} target="_blank" rel="noopener">Vinted<span class="sr-only"> (si apre in una nuova scheda)</span></a>
        </p>
      </div>
      <div class="visit-map"><MapEmbed title="Mappa di LQ Milano" /></div>
    </section>
  </div>
</Base>

<style>
  /* Homepage-scoped modern layer: hairlines instead of shadows, condensed
     Archivo titles against small mono labels, neon as the only accent. */
  .home {
        --rule: rgba(20, 18, 27, 0.14);
    --rule-strong: rgba(20, 18, 27, 0.4);
    --fs-hero: clamp(3.6rem, 1.8rem + 8vw, 11rem);
    --fs-display: clamp(2.6rem, 1.6rem + 4vw, 5.6rem);
    --block-y: clamp(72px, 9vw, 144px);
    --wide: 1440px;
    background: var(--paper);
  }
  .home .block { width: 100%; max-width: calc(var(--wide) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }
  .home .block { padding-block: var(--block-y) 0; }

  /* ---------- shared type ---------- */
  .label { font: 500 0.76rem/1.3 var(--font-label); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); margin: 0; }
  .idx { color: var(--neon-ink); margin-right: 10px; font-variant-numeric: tabular-nums; }
  .display { font-size: var(--fs-display); font-weight: 400; line-height: 0.95; letter-spacing: -0.02em; margin: 0; }
  .display em, .hero-title em { font-style: normal; color: var(--neon-ink); }
  .night .display em { color: var(--neon); }

  .head { display: grid; grid-template-columns: 1fr; gap: 14px 24px; align-items: end; padding-top: 18px; border-top: 1px solid var(--rule); margin-bottom: clamp(28px, 4vw, 56px); }
  .head .link-arrow { font-size: 0.95rem; justify-self: start; }
  .head-note { color: var(--ink-2); max-width: 52ch; margin: 0; }
  .ev-note { margin-bottom: 24px; }
  @media (min-width: 768px) {
    .head { grid-template-columns: 1fr auto; }
    .head .label { grid-column: 1 / -1; }
    .head .link-arrow, .head .head-note { grid-column: 2; grid-row: 2; justify-self: end; }
    .head .head-note { max-width: 40ch; text-align: right; }
  }

  /* ---------- buttons (home only) ---------- */
  .home .btn {
    --bg: var(--ink); --fg: var(--paper); --bd: var(--ink);
    position: relative; overflow: hidden; isolation: isolate; min-height: 52px; padding: 0 28px; border-radius: var(--radius-pill); border-width: 1px;
    font-size: 1rem;
  }
  /* hover: the fill fades in softly (no sliding block inside a pill) */
  .home .btn::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--neon); opacity: 0; transition: opacity 220ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) {
    .home .btn:hover { --fg: var(--ink); --bg: var(--ink); --bd: var(--neon); }
    .home .btn:hover::before { opacity: 1; }
  }
  .home .btn-ghost { --bg: transparent; --fg: var(--ink); --bd: var(--rule-strong); }
  .home .btn-ghost::before { background: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .home .btn-ghost:hover { --fg: var(--paper); --bg: transparent; --bd: var(--ink); } }
  .home .visit-copy .btn-ghost { --fg: var(--on-night); --bd: rgba(242, 239, 232, 0.6); }
  .home .visit-copy .btn-ghost::before { background: var(--on-night); }
  @media (hover: hover) and (pointer: fine) { .home .visit-copy .btn-ghost:hover { --fg: var(--night); --bd: var(--on-night); } }
  .home .btn-neon { --bg: var(--neon); --fg: var(--night); --bd: var(--neon); box-shadow: 0 8px 24px rgba(111, 178, 125, 0.3); }
  .home .btn-neon::before { background: var(--on-night); }
  @media (hover: hover) and (pointer: fine) { .home .btn-neon:hover { --fg: var(--night); --bg: var(--neon); --bd: var(--on-night); } }

  /* ---------- hero: full-screen, picks up where the intro leaves off ---------- */
  .hero { position: relative; min-height: calc(100svh - var(--header-h)); display: grid; grid-template-rows: 1fr auto; overflow: hidden; isolation: isolate; }
  .hero-bg { position: absolute; inset: -3%; margin: 0; z-index: -2; }
  .hero-bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; filter: saturate(0.95) brightness(0.82) contrast(1.06); }
  .hero-bg::after { /* only a soft fade at the bottom so the buttons stay legible */
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(20, 18, 27, 0) 62%, rgba(20, 18, 27, 0.7) 100%);
  }
  .hero::before { /* the wall lights up with the sign, like the intro */
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(45% 40% at 60% 30%, rgba(111, 178, 125, 0.24), transparent 70%);
  }
  .hero-copy { align-self: end; width: 100%; max-width: calc(var(--wide) + 2 * var(--gutter)); margin-inline: auto; padding: clamp(80px, 18vh, 200px) var(--gutter) clamp(20px, 3vw, 36px); }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--neon); box-shadow: 0 0 10px var(--neon-glow); flex: none; }
  .hero-line { margin: 0 0 18px; max-width: 34ch; font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem); line-height: 1.35; color: var(--on-night); text-shadow: 0 1px 2px rgba(20, 18, 27, 0.9), 0 2px 18px rgba(20, 18, 27, 0.85); width: fit-content; padding: 10px 14px; background: rgba(20, 18, 27, 0.55); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); border-radius: var(--radius-ctl); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  /* over the photo: frosted glass, like iOS controls on an image */
  .home .hero .btn-ghost {
    --fg: var(--on-night); --bg: rgba(255, 252, 246, 0.14); --bd: rgba(255, 252, 246, 0.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4);
  }
  .home .hero .btn-ghost::before { background: var(--on-night); }
  @media (hover: hover) and (pointer: fine) { .home .hero .btn-ghost:hover { --fg: var(--night); --bd: var(--on-night); } }
  @media (min-width: 1000px) {
    .hero-bg :global(img) { object-position: 50% 42%; }
    .hero::before { background: radial-gradient(34% 45% at 50% 32%, rgba(111, 178, 125, 0.2), transparent 70%); }
  }
  .hero-foot { display: flex; flex-wrap: wrap; gap: 0 28px; justify-content: space-between; padding: 6px var(--gutter); border-top: 1px solid rgba(242, 239, 232, 0.16); background: rgba(20, 18, 27, 0.55); backdrop-filter: blur(6px); font: 500 0.76rem var(--font-label); text-transform: uppercase; letter-spacing: 0.06em; color: var(--on-night-2); }
  .hero-foot > * { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; }
  .hero-foot a { color: var(--on-night); text-decoration: none; }
  .hero-foot a:hover { color: var(--neon); }
  @media (max-width: 899px) { .hero-cap, .hero-scroll { display: none !important; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg :global(img) { animation: drift 3.2s var(--ease-out) both; }
    .hero::before { animation: wall 1.4s 0.35s steps(1, end) both; }
  }
  @keyframes drift { from { transform: scale(1.1) translateX(1.5%); } to { transform: scale(1.02); } }
  @keyframes wall { 0% { opacity: 0; } 20% { opacity: 0.7; } 28% { opacity: 0.1; } 45% { opacity: 1; } 100% { opacity: 1; } }

  /* ---------- arrivals ---------- */
  .arrivals { list-style: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter); display: grid; grid-auto-flow: column; grid-auto-columns: 74%; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-padding-inline: var(--gutter); }
  .arrivals::-webkit-scrollbar { display: none; }
  .arrivals > li { scroll-snap-align: start; min-width: 0; }
  @media (min-width: 768px) {
    .arrivals { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 20px; overflow: visible; margin-inline: 0; padding-inline: 0; }
  }
  @media (min-width: 1100px) { .arrivals { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  /* flatter, boxless product cards on the homepage */
  .home .night :focus-visible { outline-color: var(--neon); }

  /* ---------- tiles (services + rooms) ---------- */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
  @media (min-width: 1100px) { .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; } }
  .tile { display: grid; gap: 12px; color: var(--ink); text-decoration: none; }
  .tile-img { transition: transform 160ms var(--ease-out); isolation: isolate; }
  .tile:active .tile-img { transform: scale(0.98); transition-duration: var(--t-press); }
  .tile-img { display: block; overflow: hidden; aspect-ratio: 3 / 4; background: var(--paper-2); border-radius: var(--radius); }
  .tile-img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.92) contrast(1.04); transition: transform 900ms var(--ease-out); }
  .tile-row { display: flex; align-items: baseline; gap: 10px; padding-top: 10px; border-top: 1px solid var(--rule); }
  .tile-n { font: 500 0.76rem var(--font-label); color: var(--neon-ink); }
  .tile-t { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.9rem); line-height: 1; flex: 1; }
  .tile-tag { font-size: 0.85rem; color: var(--ink-2); margin-top: -6px; }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover .tile-img :global(img) { transform: scale(1.04); }
    .tile:hover .tile-t { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  }


  /* ---------- services list ---------- */
  .svc-list { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--rule-strong); }
  .svc { display: grid; grid-template-columns: 2.4rem 1fr auto; gap: 6px 14px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; }
  .svc-t { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.6rem); line-height: 0.9; }
  .svc-d { grid-column: 2; color: var(--ink-2); font-size: 0.95rem; max-width: 46ch; }
  .svc :global(.svc-arrow) { grid-column: 3; grid-row: 1; align-self: center; transition: transform 160ms var(--ease-out); }
  @media (min-width: 900px) {
    .svc { grid-template-columns: 3rem minmax(0, 1.1fr) minmax(0, 1fr) auto; padding: 30px 0; }
    .svc-d { grid-column: 3; }
    .svc :global(.svc-arrow) { grid-column: 4; }
  }
  @media (hover: hover) and (pointer: fine) {
    .svc:hover .svc-t { color: var(--neon-ink); }
    .svc:hover :global(.svc-arrow) { transform: translateX(6px); }
  }

  /* ---------- people ---------- */
  .people { display: grid; gap: 32px; }
  .people-img { margin: 0; }
  .people-img :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: center 20%; border-radius: var(--radius-card); }
  .people-copy { display: grid; gap: 28px; align-content: start; padding-top: 18px; border-top: 1px solid var(--rule); }
  .quote { margin: 0; }
  .quote p:first-child { font-family: var(--font-body); font-weight: 500; font-size: clamp(1.35rem, 1.05rem + 1.3vw, 2.1rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 12px; max-width: 30ch; }
  .quote .who { font-family: var(--font-label); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); }
  .quote strong { color: var(--ink); font-weight: 600; }
  .people-copy .link-arrow { justify-self: start; }
  @media (min-width: 900px) { .people { grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 96px); align-items: start; } }

  /* ---------- brands index ---------- */
  .brand-list { list-style: none; margin: 0; padding: 0; columns: 1; column-gap: 32px; }
