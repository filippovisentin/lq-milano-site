const body = isBrand ? brand[name] : paths[name] ?? '';
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke={isBrand ? undefined : 'currentColor'}
  stroke-width={isBrand ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
