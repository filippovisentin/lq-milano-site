---
import Icon from './Icon.astro';
---
<dialog class="drawer drawer-right" id="cart-drawer" aria-labelledby="cart-title">
  <div class="drawer-head">
    <h2 id="cart-title" class="cart-title">Il tuo carrello <span class="muted tabular" data-cart-count-text></span></h2>
    <button class="icon-btn" type="button" data-close aria-label="Chiudi carrello"><Icon name="close" /></button>
  </div>
  <div class="drawer-body">
    <div class="cart-empty" data-cart-empty>
      <Icon name="bag" class="empty-icon" />
      <p class="h3">Il carrello è vuoto</p>
      <p class="muted">Ogni capo c’è una volta sola. Guarda cosa è arrivato questa settimana.</p>
      <a class="btn" href="/shop">Vai ai nuovi arrivi</a>
    </div>
    <ul class="cart-lines" data-cart-lines></ul>
  </div>
  <div class="cart-foot" data-cart-foot>
    <div class="row"><span>Subtotale</span><strong class="tabular" data-cart-subtotal>0,00 €</strong></div>
    <p class="fine">Spedizione e totale li vedi al passo successivo.</p>
    <button class="btn btn-lg btn-block" type="button" data-checkout>Vai al pagamento <Icon name="arrow" class="icon-sm" /></button>
    <a class="btn btn-ghost btn-block" href="/cart-page">Vedi carrello completo</a>
  </div>
</dialog>

<div class="toast-region" aria-live="polite" aria-atomic="true" data-toasts></div>

<template id="cart-line-tpl">
  <li class="line">
    <a class="line-img" href=""><img alt="" width="88" height="110" loading="lazy" decoding="async" /></a>
    <div class="line-body">
      <a class="line-title" href=""></a>
      <p class="line-meta"></p>
      <div class="line-actions">
        <div class="qty" role="group">
          <button type="button" class="qty-btn" data-dec><span class="sr-only">Diminuisci quantità</span><svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14"/></svg></button>
          <output class="qty-val tabular"></output>
          <button type="button" class="qty-btn" data-inc><span class="sr-only">Aumenta quantità</span><svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
        </div>
        <button type="button" class="remove" data-remove>Rimuovi</button>
      </div>
    </div>
    <strong class="line-price tabular"></strong>
  </li>
</template>

<style>
  .cart-title { font-size: 1.5rem; margin: 0; }
  .cart-title span { font-family: var(--font-body); font-size: 1rem; }
  .cart-empty { display: grid; justify-items: start; gap: 4px; padding: 24px 0; }
  .cart-empty :global(.empty-icon) { width: 44px; height: 44px; color: var(--gold-ink); margin-bottom: 8px; }
  .cart-empty .h3 { margin: 0; }
  .cart-empty .btn { margin-top: 12px; }
  .cart-lines { list-style: none; margin: 0; padding: 0; }
  :global(.line) { display: grid; grid-template-columns: 88px 1fr auto; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--line); align-items: start; }
  :global(.line-img) { display: block; background: var(--tile); border-radius: var(--radius-ctl); overflow: hidden; aspect-ratio: 4/5; isolation: isolate; }
  :global(.line-img img) { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; filter: brightness(1.05); }
  :global(.line-title) { font-weight: 600; text-decoration: none; line-height: 1.3; display: block; }
  :global(.line-title:hover) { text-decoration: underline; }
  :global(.line-meta) { margin: 2px 0 8px; font-size: 0.88rem; color: var(--ink-2); }
  :global(.line-actions) { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  :global(.qty) { display: inline-flex; align-items: center; border: 1.5px solid var(--line-strong); border-radius: 999px; }
  :global(.qty-btn) { width: 40px; height: 40px; display: grid; place-items: center; border: 0; background: none; border-radius: 999px; transition: background-color 200ms var(--ease-soft), transform 160ms var(--ease-out); }
  :global(.qty-btn:hover:not(:disabled)) { background: rgba(26, 25, 25, 0.07); }
  :global(.qty-btn:active:not(:disabled)) { transform: scale(0.9); }
  :global(.qty-btn:disabled) { opacity: 0.35; cursor: not-allowed; }
  :global(.qty-val) { min-width: 22px; text-align: center; font-weight: 600; }
  :global(.remove) { border: 0; background: none; padding: 10px 2px; color: var(--ink-2); text-decoration: underline; font-size: 0.9rem; min-height: 44px; }
  :global(.remove:hover) { color: var(--danger); }
  :global(.line-price) { font-size: 0.98rem; }
  .cart-foot { border-top: 1px solid var(--line); padding: 16px 20px calc(16px + env(safe-area-inset-bottom)); display: grid; gap: 10px; background: var(--surface); }
  .cart-foot .row { display: flex; justify-content: space-between; font-size: 1.1rem; }
  .fine { margin: 0; font-size: 0.86rem; color: var(--ink-2); }

  .toast-region {
    position: fixed; z-index: var(--z-toast); left: 50%; bottom: calc(16px + env(safe-area-inset-bottom)); transform: translateX(-50%);
    display: grid; gap: 8px; width: min(440px, calc(100vw - 32px)); pointer-events: none;
  }
  :global(.toast) {
    pointer-events: auto; display: flex; align-items: center; gap: 12px; padding: 12px 14px 12px 18px; border-radius: var(--radius-card);
    background: var(--night); color: var(--on-night); box-shadow: var(--shadow-2); font-size: 0.95rem;
    animation: toast-in 260ms var(--ease-out);
  }
  :global(.toast p) { margin: 0; flex: 1; }
  :global(.toast button), :global(.toast a) { color: var(--gold); background: none; border: 0; font-weight: 600; min-height: 40px; padding: 0 6px; text-decoration: underline; }
  :global(.toast.is-leaving) { animation: toast-out 180ms var(--ease-in) forwards; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(12px); } }
  @keyframes toast-out { to { opacity: 0; transform: translateY(8px); } }
</style>

<script>
  import * as cart from '../lib/commerce/cart';
  import { commerce } from '../lib/commerce/provider';

  const dlg = document.getElementById('cart-drawer') as HTMLDialogElement;
  const list = dlg.querySelector<HTMLUListElement>('[data-cart-lines]')!;
  const tpl = document.getElementById('cart-line-tpl') as HTMLTemplateElement;
  const toasts = document.querySelector<HTMLElement>('[data-toasts]')!;

  function toast(msg: string, action?: { label: string; href?: string; onClick?: () => void }) {
    const el = document.createElement('div');
    el.className = 'toast';
    const p = document.createElement('p');
    p.textContent = msg;
    el.append(p);
    if (action) {
      const a = action.href ? document.createElement('a') : document.createElement('button');
      a.textContent = action.label;
      if (action.href) (a as HTMLAnchorElement).href = action.href;
      else (a as HTMLButtonElement).type = 'button';
      a.addEventListener('click', () => { action.onClick?.(); dismiss(); });
      el.append(a);
    }
    toasts.append(el);
    const dismiss = () => { el.classList.add('is-leaving'); setTimeout(() => el.remove(), 200); };
    setTimeout(dismiss, 4500);
  }
  (window as any).lqToast = toast;

  function render() {
    const s = cart.get();
    const n = cart.count();
    document.documentElement.classList.toggle('has-items', n > 0);
    document.querySelectorAll('[data-cart-count]').forEach((e) => (e.textContent = String(n)));
    document.querySelectorAll('[data-cart-label]').forEach((e) => (e.textContent = n ? `Carrello, ${n} ${n === 1 ? 'articolo' : 'articoli'}` : 'Carrello, vuoto'));
    dlg.querySelector('[data-cart-count-text]')!.textContent = n ? `(${n})` : '';
    dlg.querySelector<HTMLElement>('[data-cart-empty]')!.hidden = n > 0;
    dlg.querySelector<HTMLElement>('[data-cart-foot]')!.hidden = n === 0;
    dlg.querySelector('[data-cart-subtotal]')!.textContent = cart.euro(cart.subtotal());
    list.replaceChildren(...s.items.map((it) => {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      li.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => (a.href = it.url));
      const img = li.querySelector('img')!;
      img.src = it.image; img.alt = it.title;
      li.querySelector('.line-title')!.textContent = it.title;
      li.querySelector('.line-meta')!.textContent = [it.size ? `Taglia ${it.size}` : null, it.max === 1 ? 'Pezzo unico' : null].filter(Boolean).join(' · ');
      li.querySelector('.qty-val')!.textContent = String(it.qty);
      li.querySelector('.qty')!.setAttribute('aria-label', `Quantità di ${it.title}`);
      (li.querySelector('[data-inc]') as HTMLButtonElement).disabled = it.qty >= it.max;
      li.querySelector('[data-inc]')!.addEventListener('click', () => cart.setQty(it.id, it.qty + 1));
      li.querySelector('[data-dec]')!.addEventListener('click', () => cart.setQty(it.id, it.qty - 1));
      li.querySelector('[data-remove]')!.addEventListener('click', () => {
        cart.remove(it.id);
        toast(`${it.title} rimosso dal carrello.`, { label: 'Annulla', onClick: () => cart.undoRemove() });
      });
      li.querySelector('.line-price')!.textContent = cart.euro(it.price * it.qty);
      return li;
    }));
  }

  render();
  window.addEventListener('cart:change', render);

  document.querySelectorAll('[data-open-cart]').forEach((b) => b.addEventListener('click', () => dlg.showModal()));
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  window.addEventListener('cart:open', () => { if (!dlg.open) dlg.showModal(); });

  dlg.querySelector<HTMLButtonElement>('[data-checkout]')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    try {
      const { redirectUrl } = await commerce.createCheckout(cart.get());
      location.href = redirectUrl;
    } catch {
      btn.disabled = false;
      toast('Non è stato possibile avviare il checkout. Riprova tra poco.');
    }
  });
</script>
