---
// Google Maps embed that loads only with consent. Until then: a quiet
// placeholder with "Mostra la mappa" (which records the consent) and a plain
// link to open Google Maps in a new tab (no data sent from this page).
import site from '../data/site.json';
interface Props { title: string; zoom?: number; interactive?: boolean; class?: string }
const { title, zoom = 16, interactive = true, class: cls } = Astro.props;
const q = encodeURIComponent(`${site.address.street}, ${site.address.postcode} ${site.address.city}`);
const src = `https://www.google.com/maps?q=${q}&z=${zoom}&output=embed`;
---
<div class:list={['mapx', cls, { 'no-pointer': !interactive }]} data-mapx data-src={src} data-title={title}>
  <div class="mapx-ph" data-mapx-ph>
    <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="10" r="2.6" fill="currentColor" /></svg>
    <p><strong>{site.address.street}</strong><br />{site.address.postcode} {site.address.city} · {site.address.area}</p>
    <div class="mapx-btns">
      <button class="btn btn-sm" type="button" data-mapx-load>Mostra la mappa</button>
      <a class="btn btn-sm btn-ghost" href={site.mapsUrl} target="_blank" rel="noopener">Apri in Google Maps</a>
    </div>
    <p class="mapx-note">La mappa è di Google: mostrandola accetti i suoi cookie. <a href="/cookie">Dettagli</a></p>
  </div>
</div>

<style>
  .mapx { position: relative; width: 100%; height: 100%; min-height: 260px; background: #ece7dc repeating-linear-gradient(45deg, rgba(20, 18, 27, 0.04) 0 2px, transparent 2px 14px); }
  .mapx :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .mapx.no-pointer :global(iframe) { pointer-events: none; }
  .mapx-ph { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 10px; padding: 20px; text-align: center; color: var(--ink); }
  .mapx-ph p { margin: 0; line-height: 1.4; }
  .mapx-btns { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .mapx-note { font-size: 0.8rem; color: var(--ink-2); max-width: 32ch; }
</style>

<script>
  import { onConsent, setConsent } from '../lib/consent';
  const load = (el: HTMLElement) => {
    if (el.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = el.dataset.src!; f.title = el.dataset.title!; f.loading = 'lazy';
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    el.append(f);
    el.querySelector<HTMLElement>('[data-mapx-ph]')!.hidden = true;
  };
  const unload = (el: HTMLElement) => {
    el.querySelector('iframe')?.remove();
    el.querySelector<HTMLElement>('[data-mapx-ph]')!.hidden = false;
  };
  document.querySelectorAll<HTMLElement>('[data-mapx]').forEach((el) => {
    el.querySelector('[data-mapx-load]')!.addEventListener('click', () => setConsent(true));
    onConsent((c) => (c?.maps ? load(el) : unload(el)));
  });
</script>
