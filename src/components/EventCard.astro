---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { eventUrl, fmtDay, fmtMonth, fmtYear, fmtTime, eventEnd, type Event } from '../lib/products';
interface Props { event: Event; headingLevel?: 'h2' | 'h3' }
const { event, headingLevel = 'h3' } = Astro.props;
const d = event.data;
const H = headingLevel;
const past = eventEnd(event).getTime() < Date.now();
const status = past ? 'Concluso' : d.registration === 'aperta' ? 'Iscrizioni aperte' : d.registration === 'esaurita' ? 'Posti esauriti' : 'Iscrizioni chiuse';
---
<article class="ev" data-event data-end={eventEnd(event).toISOString()} data-reg={d.registration}>
  <a href={eventUrl(event.id)} class="ev-link">
    <div class="ev-media">
      <Picture src={d.poster} alt={`Locandina di ${d.title}`} widths={[360, 560, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw" formats={['avif']} fallbackFormat="webp" loading="lazy" />
      <time class="ev-date" datetime={d.start.toISOString()}>
        <span class="d">{fmtDay(d.start)}</span><span class="m">{fmtMonth(d.start)}</span><span class="y">{fmtYear(d.start)}</span>
      </time>
    </div>
    <div class="ev-body">
      <span class:list={['badge', past ? '' : d.registration === 'aperta' ? 'badge-gold' : '']} data-ev-status>{status}</span>
      <H class="ev-title">{d.title}</H>
      {d.tagline && <p class="ev-tag">{d.tagline}</p>}
      <p class="ev-meta"><Icon name="clock" class="icon-sm" /> {fmtTime(d.start)}{d.end && `–${fmtTime(d.end)}`}</p>
      <p class="ev-meta"><Icon name="pin" class="icon-sm" /> {d.venue}</p>
      <span class="link-arrow"><span>Dettagli dell’evento</span><Icon name="arrow" class="icon-sm" /></span>
    </div>
  </a>
</article>

<style>
  .ev-link { display: grid; height: 100%; text-decoration: none; color: inherit; background: var(--surface); border-radius: 6px; overflow: hidden; box-shadow: var(--shadow-1); transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med); }
  .ev-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .ev-media { position: relative; aspect-ratio: 4 / 3; background: var(--night); overflow: hidden; }
  .ev-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .ev-date {
    position: absolute; top: 12px; left: 12px; display: grid; justify-items: center; min-width: 62px; padding: 8px 10px 6px; border-radius: 8px;
    background: var(--surface); color: var(--ink); line-height: 1; box-shadow: var(--shadow-1);
  }
  .ev-date .d { font-family: var(--font-display); font-size: 1.7rem; }
  .ev-date .m { text-transform: uppercase; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; margin-top: 4px; }
  .ev-date .y { font-size: 0.72rem; color: var(--ink-2); margin-top: 2px; }
  .ev-body { padding: 18px 18px 14px; display: grid; gap: 6px; align-content: start; }
  .ev-title { font-size: 1.5rem; margin: 6px 0 0; }
  .ev-tag { margin: 0; font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold-ink); font-weight: 600; }
  .ev-meta { margin: 0; display: flex; gap: 8px; align-items: center; color: var(--ink-2); font-size: 0.92rem; }
  .ev-body .badge { justify-self: start; }
  .ev-link:hover .link-arrow span { text-decoration: underline; }
</style>
