---
import Icon from './Icon.astro';
import { eventUrl, fmtDay, fmtMonth, fmtYear, fmtTime, eventEnd, isPast, imgUrl, srcset, type LqEvent } from '../lib/catalog';
interface Props { event: LqEvent; headingLevel?: 'h2' | 'h3' }
const { event: e, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const start = new Date(e.start);
const past = isPast(e);
const status = past ? 'Concluso' : e.registration === 'aperta' ? 'Iscrizioni aperte' : e.registration === 'esaurita' ? 'Posti esauriti' : 'Iscrizioni chiuse';
---
<article class="ev" data-event data-end={eventEnd(e).toISOString()}>
  <a href={eventUrl(e.slug)} class="ev-link">
    <div class="ev-media">
      {e.poster && <img src={imgUrl('events', e.slug, e.poster, 960)} srcset={srcset('events', e.slug, e.poster)} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw" alt={`Locandina di ${e.title}`} width={e.poster.w} height={e.poster.h} loading="lazy" decoding="async" />}
      <time class="ev-date" datetime={start.toISOString()}>
        <span class="d">{fmtDay(start)}</span><span class="m">{fmtMonth(start)}</span><span class="y">{fmtYear(start)}</span>
      </time>
    </div>
    <div class="ev-body">
      <span class:list={['badge', !past && e.registration === 'aperta' && 'badge-gold']}>{status}</span>
      <H class="ev-title">{e.title}</H>
      {e.tagline && <p class="ev-tag">{e.tagline}</p>}
      <p class="ev-meta"><Icon name="clock" class="icon-sm" /> {fmtTime(start)}{e.end && `–${fmtTime(new Date(e.end))}`}</p>
      <p class="ev-meta"><Icon name="pin" class="icon-sm" /> {e.venue}</p>
      <span class="link-arrow"><span>Dettagli dell’evento</span><Icon name="arrow" class="icon-sm" /></span>
    </div>
  </a>
</article>

<style>
  .ev-link { display: grid; grid-template-rows: auto 1fr; height: 100%; text-decoration: none; color: inherit; border-top: 1px solid var(--line-strong); padding-top: 14px; }
  .ev-media img { transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .ev-link:hover .ev-media img { transform: scale(1.04); } .ev-link:hover .ev-title { color: var(--neon-ink); } }
  .ev-media {
    position: relative; aspect-ratio: 4 / 5; background: var(--night); overflow: hidden; border-radius: var(--radius);
    transition: transform 160ms var(--ease-out); isolation: isolate;
  }
  .ev-link { -webkit-tap-highlight-color: transparent; }
  .ev-link:active .ev-media { transform: scale(0.98); transition-duration: var(--t-press); }
  .ev-media img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .ev-date { position: absolute; top: 10px; left: 10px; display: grid; justify-items: center; min-width: 64px; padding: 10px 12px 8px; border-radius: 14px; background: rgba(20, 18, 27, 0.82); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: var(--on-night); line-height: 1; }
  .ev-date .d { font-family: var(--font-display); font-size: 2.4rem; font-weight: 400; color: var(--neon); }
  .ev-date .m { font-family: var(--font-label); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.06em; margin-top: 4px; }
  .ev-date .y { font-family: var(--font-label); font-size: 0.68rem; color: var(--on-night-2); margin-top: 2px; }
  .ev-body { padding: 16px 0 6px; display: grid; gap: 6px; align-content: start; }
  .ev-title { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); margin: 6px 0 0; transition: color 160ms; }
  .ev-tag { margin: 0; font-family: var(--font-label); font-size: 0.76rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-ink); font-weight: 500; }
  .ev-meta { margin: 0; display: flex; gap: 8px; align-items: center; color: var(--ink-2); font: 500 0.78rem var(--font-label); text-transform: uppercase; letter-spacing: 0.06em; }
  .ev-body .badge { justify-self: start; }
  .ev-link:hover .link-arrow span { text-decoration: underline; }
</style>
