---
// A live rotating garment for the home. Lazy: three.js loads only when the
// block approaches the viewport.
import Icon from './Icon.astro';
import { productUrl, euro, era, modelBase, type Product } from '../lib/catalog';
interface Props { product: Product }
const { product: p } = Astro.props;
const anni = era(p.details.anni);
const base = modelBase(p);
---
<section class="spot night" aria-labelledby="spot-title">
  <div class="container spot-grid">
    <div class="spot-copy reveal">
      <p class="eyebrow">Gira il capo · vista 3D</p>
      <h2 id="spot-title">Prima di sceglierlo, <em>giralo.</em></h2>
      <p class="lead">Nello shop ogni capo si ruota a 360°, ricostruito dalle nostre foto: fronte, fianco, retro. Poi le foto per etichetta, tessuto e cuciture.</p>
      <div class="spot-product">
        <p class="sp-name">{p.title}</p>
        <p class="sp-meta tabular">{euro(p.price)}{p.size && ` · Taglia ${p.size}`}{anni && ` · Anni ${anni}`}</p>
      </div>
      <a class="btn btn-gold btn-lg" href={productUrl(p.slug)}>Scopri il capo <Icon name="arrow" class="icon-sm" /></a>
    </div>
    <div class="spot-stage">
      <div class="spot-viewer" data-spot data-base={base} data-version={p.model3d.version} tabindex="0" role="img" aria-label={`${p.title}, vista 3D rotante: trascina o usa le frecce per ruotarlo`}>
        <img class="poster" src={`${base}/front.webp?v=${p.model3d.version}`} alt="" width="1024" height="1024" loading="lazy" />
      </div>
      <p class="spot-hint"><Icon name="rotate" class="icon-sm" /> Trascina per ruotare</p>
    </div>
  </div>
</section>

<style>
  .spot { position: relative; overflow: hidden; padding-block: clamp(56px, 8vw, 112px); }
  .spot::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(40% 55% at 72% 50%, rgba(255, 91, 36, 0.18), transparent 70%), radial-gradient(60% 50% at 10% 100%, rgba(216, 183, 90, 0.08), transparent 70%);
  }
  .spot-grid { position: relative; display: grid; gap: 24px; align-items: center; }
  @media (min-width: 900px) { .spot-grid { grid-template-columns: 1fr 1.15fr; gap: 56px; } }
  .spot-copy h2 { max-width: 14ch; font-size: clamp(2.2rem, 1.6rem + 3vw, 4rem); }
  .spot-copy h2 em { font-style: italic; color: var(--gold); }
  .spot-product { margin: 24px 0; padding: 16px 0; border-top: 1px solid rgba(244, 236, 221, 0.14); border-bottom: 1px solid rgba(244, 236, 221, 0.14); }
  .sp-name { font-family: var(--font-display); font-size: 1.4rem; margin: 0 0 2px; }
  .sp-meta { margin: 0; color: var(--on-night-2); }
  .spot-viewer { position: relative; aspect-ratio: 1; cursor: grab; border-radius: 50%; outline-offset: 8px; }
  .spot-viewer :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .spot-viewer:global(.is-grabbing) { cursor: grabbing; }
  .poster { position: absolute; inset: 9%; width: 82%; height: 82%; object-fit: contain; transition: opacity 400ms; }
  .spot-viewer:global(.is-ready) .poster { opacity: 0; }
  .spot-hint { display: flex; justify-content: center; gap: 6px; align-items: center; margin: 0; color: var(--on-night-2); font-size: 0.88rem; }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-spot]');
  if (host) {
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      try {
        const { mountViewer } = await import('../scripts/garment-viewer');
        await mountViewer(host, { base: host.dataset.base!, version: host.dataset.version });
        host.classList.add('is-ready');
      } catch { /* poster stays */ }
    }, { rootMargin: '300px' });
    io.observe(host);
  }
</script>
