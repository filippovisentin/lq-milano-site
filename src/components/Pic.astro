---
// Static responsive image for page imagery, served from public/img (built by
// scripts/page-images.mjs). Works the same on prerendered and on-demand pages.
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  style?: string;
}
const { src, alt, sizes = '100vw', loading = 'lazy', fetchpriority, class: cls, style } = Astro.props;
// "/_astro/name.HASH.webp" (build) or "/@fs/.../name.webp?..." (dev) -> "name"
const file = src.src.split('?')[0].split('/').pop()!;
const stem = file.replace(/\.[^.]+$/, '').replace(/\.[A-Za-z0-9_-]{8}$/, '');
const widths = [480, 760, 1100, 1600].filter((w, i) => i === 0 || w <= src.width * 1.1);
const url = (w: number) => `/img/${stem}-${w}.webp`;
const h = Math.round((src.height / src.width) * 1000);
---
<img
  src={url(widths[Math.min(1, widths.length - 1)])}
  srcset={widths.map((w) => `${url(w)} ${Math.min(w, src.width)}w`).join(', ')}
  sizes={sizes}
  alt={alt}
  width="1000"
  height={h}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={cls}
  style={style}
/>
