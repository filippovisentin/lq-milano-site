---
import NeonLogo from './NeonLogo.astro';
import Icon from './Icon.astro';
import { mainNav, isActive } from '../lib/nav';
import site from '../data/site.json';
const path = decodeURI(Astro.url.pathname).replace(/\/$/, '') || '/';
---
<header class="site-header on-night" id="top">
  <div class="bar container">
    <button class="icon-btn menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu-drawer" data-open-menu>
      <Icon name="menu" />
      <span class="menu-label">Menu</span>
    </button>

    <a class="brand" href="/" aria-label="LQ Milano Vintage, vai alla home">
      <NeonLogo size="sm" />
    </a>

    <nav class="primary" aria-label="Principale">
      <ul>
        {mainNav.map((item) =>
          'children' in item ? (
            <li class="has-sub">
              <a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>{item.label}</a>
              <button class="sub-toggle" type="button" aria-expanded="false" aria-controls="sub-servizi">
                <Icon name="chevron-down" class="icon-sm" />
                <span class="sr-only">Mostra tutti i servizi</span>
              </button>
              <div class="sub" id="sub-servizi">
                <div class="sub-inner">
                  <ul class="sub-list">
                    {item.children.map((c) => (
                      <li><a href={c.href}><strong>{c.label}</strong><span>{c.desc}</span></a></li>
                    ))}
                  </ul>
                  <ul class="sub-extra">
                    {item.extra.map((c) => (
                      <li><a href={c.href}><strong>{c.label}</strong><span>{c.desc}</span></a></li>
                    ))}
                    <li><a class="sub-all" href="/servizi">Tutti i servizi <Icon name="arrow" class="icon-sm" /></a></li>
                  </ul>
                </div>
              </div>
            </li>
          ) : (
            <li><a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>{item.label}</a></li>
          )
        )}
      </ul>
    </nav>

    <div class="tools">
      <a class="icon-btn account" href="/account" aria-label="Accedi o registrati" aria-current={path === '/account' ? 'page' : undefined}>
        <Icon name="user" />
      </a>
      <button class="icon-btn cart-btn" type="button" aria-haspopup="dialog" aria-controls="cart-drawer" data-open-cart>
        <Icon name="bag" />
        <span class="cart-count" data-cart-count aria-hidden="true">0</span>
        <span class="sr-only" data-cart-label>Carrello, vuoto</span>
      </button>
    </div>
  </div>
</header>

<dialog class="drawer drawer-left on-night" id="menu-drawer" aria-label="Menu">
  <div class="drawer-head">
    <a href="/" class="brand" aria-label="Home"><NeonLogo size="sm" /></a>
    <button class="icon-btn" type="button" data-close aria-label="Chiudi menu"><Icon name="close" /></button>
  </div>
  <nav class="drawer-body" aria-label="Menu principale">
    <ul class="m-list">
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
      {mainNav.map((item) =>
        'children' in item ? (
          <li>
            <details class="m-group" open={isActive(path, '/servizi') || path === '/fornitura' || path === '/galleria'}>
              <summary>{item.label}<Icon name="chevron-down" class="icon-sm" /></summary>
              <ul>
                <li><a href={item.href} aria-current={path === '/servizi' ? 'page' : undefined}>Tutti i servizi</a></li>
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                {item.extra.map((c) => <li><a href={c.href} aria-current={isActive(path, c.href) ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            </details>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>{item.label}</a></li>
        )
      )}
    </ul>
    <div class="m-secondary">
      <a class="btn btn-ghost btn-block" href="/account"><Icon name="user" class="icon-sm" /> Accedi o registrati</a>
      <a class="btn btn-gold btn-block" href={site.whatsapp} rel="noopener" target="_blank"><Icon name="whatsapp" class="icon-sm" /> Scrivici su WhatsApp</a>
      <p class="m-addr"><Icon name="pin" class="icon-sm" /> {site.address.street}, {site.address.postcode} {site.address.city}</p>
    </div>
  </nav>
</dialog>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-header);
    background: rgba(23, 20, 17, 0.94);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    color: var(--on-night);
    border-bottom: 1px solid rgba(244, 236, 221, 0.08);
    padding-top: env(safe-area-inset-top);
  }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: var(--header-h); gap: 8px; }
  .brand { justify-self: center; text-decoration: none; display: inline-flex; border-radius: 8px; }
  .brand :global(.neon-logo) { --fs: 1.3rem; }
  .menu-btn { justify-self: start; width: auto; padding: 0 12px 0 10px; border-radius: 999px; gap: 8px; display: inline-flex; font-weight: 600; font-size: 0.92rem; }
  .icon-btn:hover { background: rgba(244, 236, 221, 0.09); }
  .tools { justify-self: end; display: flex; gap: 2px; }
  .account { display: none; }
  .primary { display: none; }
  .cart-count {
    position: absolute; top: 4px; right: 2px; min-width: 19px; height: 19px; padding: 0 5px; border-radius: 999px;
    background: var(--gold); color: var(--ink); font-size: 0.72rem; font-weight: 700; display: grid; place-items: center;
    transform: scale(0); transition: transform var(--t-med) var(--ease-out);
  }
  :global(.has-items) .cart-count { transform: scale(1); }
  :global(.cart-bump) .cart-count { animation: bump 420ms var(--ease-out); }
  @keyframes bump { 40% { transform: scale(1.35); } }

  @media (min-width: 1100px) {
    .bar { grid-template-columns: auto 1fr auto; gap: 24px; }
    .brand { justify-self: start; }
    .brand :global(.neon-logo) { --fs: 1.4rem; }
    .menu-btn { display: none; }
    .account { display: inline-grid; }
    .primary { display: block; justify-self: center; }
    .primary > ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
    .primary > ul > li { position: relative; display: flex; align-items: center; }
    .primary > ul > li > a {
      display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px;
      text-decoration: none; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; color: var(--on-night-2); transition: color var(--t-fast), background var(--t-fast);
    }
    .primary > ul > li > a:hover { color: var(--on-night); background: rgba(244, 236, 221, 0.07); }
    .primary > ul > li > a:active { transform: scale(0.96); }
    .primary > ul > li > a { position: relative; }
    .primary a[aria-current='page'] { color: var(--on-night); }
    .primary a[aria-current='page']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 6px; height: 2px; border-radius: 2px; background: var(--gold); }
    .has-sub > a[aria-current='page']::after { right: 4px; }
    .has-sub > a { padding-right: 4px !important; }
    .sub-toggle { width: 32px; height: 44px; border: 0; background: none; color: var(--on-night-2); display: grid; place-items: center; border-radius: var(--radius-pill); }
    .sub-toggle :global(svg) { transition: transform var(--t-fast); }
    .sub-toggle[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
    .sub {
      position: absolute; top: calc(100% + 10px); left: 50%; width: min(760px, 90vw); transform: translate(-50%, -6px);
      opacity: 0; visibility: hidden; transition: opacity var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out), visibility 0s linear var(--t-med);
    }
    .sub::before { content: ''; position: absolute; inset: -12px 0 auto; height: 12px; }
    .has-sub.open .sub { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
    .sub-inner {
      display: grid; grid-template-columns: 1.5fr 1fr; gap: 8px; padding: 14px; border-radius: var(--radius-card);
      background: var(--surface); color: var(--ink); box-shadow: var(--shadow-2);
    }
    .sub ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; align-content: start; }
    .sub-extra { border-left: 1px solid var(--line); padding-left: 8px !important; }
    .sub a { display: grid; gap: 2px; padding: 10px 12px; border-radius: var(--radius-ctl); text-decoration: none; transition: background-color 200ms var(--ease-soft); }
    .sub a:hover { background: var(--paper-2); }
    .sub strong { font-weight: 600; font-size: 0.95rem; }
    .sub span { font-size: 0.84rem; color: var(--ink-2); line-height: 1.35; }
    .sub .sub-all { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--olive); }
    .sub :global(:focus-visible) { outline-color: var(--olive); }
  }

  /* ----- Drawer (shared with cart drawer via global) ----- */
  :global(.drawer) {
    position: fixed; inset: 0 auto 0 0; margin: 0; height: 100dvh; max-height: 100dvh; width: min(420px, 100vw); max-width: 100vw;
    padding: 0; border: 0; display: flex; flex-direction: column;
    background: var(--night); color: var(--on-night);
    transform: translateX(-100%); transition: transform 320ms var(--ease-drawer), overlay 320ms allow-discrete, display 320ms allow-discrete;
    border-radius: 0 var(--radius-card) var(--radius-card) 0; overflow: hidden; /* soft inner edge, like an iOS sheet */
  }
  :global(.drawer:not([open])) { display: none; }
  :global(.drawer[open]) { transform: none; }
  @starting-style { :global(.drawer[open]) { transform: translateX(-100%); } }
  :global(.drawer-right) { inset: 0 0 0 auto; transform: translateX(100%); background: var(--surface); color: var(--ink); border-radius: var(--radius-card) 0 0 var(--radius-card); }
  @starting-style { :global(.drawer-right[open]) { transform: translateX(100%); } }
  :global(.drawer::backdrop) { background: rgba(10, 8, 6, 0.55); opacity: 1; transition: opacity 320ms, overlay 320ms allow-discrete, display 320ms allow-discrete; }
  @starting-style { :global(.drawer[open]::backdrop) { opacity: 0; } }
  :global(.drawer-head) {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: calc(12px + env(safe-area-inset-top)) 16px 12px 20px; border-bottom: 1px solid rgba(244, 236, 221, 0.1);
  }
  :global(.drawer-right .drawer-head) { border-color: var(--line); }
  :global(.drawer-body) { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 8px 20px calc(24px + env(safe-area-inset-bottom)); }

  .drawer .brand :global(.neon-logo) { --fs: 1.25rem; }
  .m-list { list-style: none; padding: 0; margin: 0; }
  .m-list > li { border-bottom: 1px solid rgba(244, 236, 221, 0.1); }
  .m-list a, .m-group summary {
    display: flex; align-items: center; justify-content: space-between; min-height: 56px; text-decoration: none;
    font-family: var(--font-display); font-size: 1.9rem; font-weight: 800; text-transform: uppercase; color: var(--on-night);
  }
  .m-list a[aria-current='page'] { color: var(--gold); }
  .m-group summary { list-style: none; cursor: pointer; }
  .m-group summary::-webkit-details-marker { display: none; }
  .m-group summary :global(svg) { transition: transform var(--t-fast); }
  .m-group[open] summary :global(svg) { transform: rotate(180deg); }
  .m-group ul { list-style: none; padding: 0 0 12px 12px; margin: 0; border-left: 1px solid rgba(216, 183, 90, 0.4); }
  .m-group ul a { font-family: var(--font-body); font-size: 1rem; min-height: 46px; color: var(--on-night-2); }
  .m-secondary { display: grid; gap: 10px; margin-top: 24px; }
  .m-addr { display: flex; gap: 8px; align-items: center; color: var(--on-night-2); font-size: 0.92rem; margin: 6px 0 0; }
</style>

<script>
  // Desktop "Servizi" flyout: click/tap toggles, hover opens for fine pointers, Esc closes.
  const li = document.querySelector<HTMLElement>('.has-sub');
  const toggle = li?.querySelector<HTMLButtonElement>('.sub-toggle');
  if (li && toggle) {
    let t: number | undefined;
    const set = (open: boolean) => { li.classList.toggle('open', open); toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => set(!li.classList.contains('open')));
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      li.addEventListener('mouseenter', () => { clearTimeout(t); set(true); });
      li.addEventListener('mouseleave', () => { t = window.setTimeout(() => set(false), 180); });
    }
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); toggle.focus(); } });
    document.addEventListener('click', (e) => { if (!li.contains(e.target as Node)) set(false); });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
  }

  // Menu drawer (native <dialog>: focus trap + Esc for free; focus restored on close)
  const menu = document.getElementById('menu-drawer') as HTMLDialogElement | null;
  document.querySelectorAll('[data-open-menu]').forEach((b) => b.addEventListener('click', () => menu?.showModal()));
  menu?.querySelector('[data-close]')?.addEventListener('click', () => menu.close());
  menu?.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
</script>
