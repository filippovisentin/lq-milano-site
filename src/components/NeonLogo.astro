---
// Vector neon wordmark redrawn from the shop's "LQ Milano Vintage" neon sign.
// Pure text + CSS glow: crisp at any size, no raster image.
// `animated` splits letters so the loader can flicker each tube on.
interface Props { size?: 'sm' | 'md' | 'lg' | 'xl'; animated?: boolean; as?: string; class?: string }
const { size = 'md', animated = false, class: cls = '' } = Astro.props;
const lines = ['LQ Milano', 'Vintage'];
// deterministic pseudo-random delays so every letter warms up differently
const delay = (i: number) => (((i * 7919) % 97) / 97) * 0.55 + (i % 3) * 0.05;
let n = 0;
---
<span class:list={['neon-logo', `neon-${size}`, animated && 'is-animated', cls]} role="img" aria-label="LQ Milano Vintage">
  {lines.map((line, li) => (
    <span class={`neon-line l${li + 1}`} aria-hidden="true">
      {animated
        ? [...line].map((ch) => {
            const i = n++;
            return ch === ' ' ? <span class="sp"> </span> : <span class="tube" style={`--d:${delay(i).toFixed(2)}s`}>{ch}</span>;
          })
        : line}
    </span>
  ))}
</span>

<style>
  .neon-logo {
    --fs: 2.2rem;
    display: inline-grid;
    font-family: var(--font-neon);
    font-size: var(--fs);
    line-height: 0.92;
    color: var(--neon-core);
    white-space: nowrap;
    user-select: none;
    text-shadow:
      0 0 1px #fff,
      0 0 0.06em var(--neon),
      0 0 0.14em var(--neon),
      0 0 0.32em var(--neon-glow),
      0 0 0.7em rgba(255, 70, 10, 0.5);
    /* a hint of tube thickness: neon script fonts are hairline */
    -webkit-text-stroke: 0.006em rgba(255, 210, 180, 0.9);
    padding: 0.08em 0.12em 0.18em;
  }
  .neon-line { display: block; }
  .l1 { padding-right: 0.5em; }
  .l2 { padding-left: 1.1em; margin-top: -0.06em; }
  .neon-sm { --fs: 1.45rem; }
  .neon-md { --fs: 2.1rem; }
  .neon-lg { --fs: clamp(2.7rem, 1.7rem + 4.6vw, 5.2rem); }
  .neon-xl { --fs: clamp(3.1rem, 1.6rem + 7.5vw, 7.2rem); }

  .tube { display: inline-block; }
  .sp { display: inline-block; width: 0.28em; }

  .is-animated .tube {
    color: #4a2416;
    text-shadow: none;
    -webkit-text-stroke: 0.012em #5b2a18;
    animation: tube-on 1.15s var(--d) steps(1, end) forwards;
  }
  @keyframes tube-on {
    0%   { color: #4a2416; text-shadow: none; }
    12%  { color: var(--neon-core); text-shadow: 0 0 0.14em var(--neon), 0 0 0.32em var(--neon-glow); }
    18%  { color: #4a2416; text-shadow: none; }
    30%  { color: var(--neon-core); text-shadow: 0 0 0.14em var(--neon), 0 0 0.32em var(--neon-glow); }
    36%  { color: #6a301a; text-shadow: 0 0 0.1em rgba(255, 80, 20, 0.3); }
    52%, 100% {
      color: var(--neon-core);
      -webkit-text-stroke: 0.006em rgba(255, 210, 180, 0.9);
      text-shadow: 0 0 1px #fff, 0 0 0.06em var(--neon), 0 0 0.14em var(--neon), 0 0 0.32em var(--neon-glow), 0 0 0.7em rgba(255, 70, 10, 0.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-animated .tube { animation: none; color: var(--neon-core); text-shadow: inherit; -webkit-text-stroke: inherit; }
  }
</style>
