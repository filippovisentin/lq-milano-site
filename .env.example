# Copy to .env (never commit .env). Admin users + TOTP keys: npm run admin:create -- <name> <role>; they live in data/private/users.json, only SESSION_SECRET is here.
SESSION_SECRET=
# Commerce provider: demo (default) | wix | stripe | shopify — see src/lib/commerce/provider.ts
PUBLIC_COMMERCE_PROVIDER=demo
# Contact form JSON endpoint (Formspree, Web3Forms, Worker…). Empty = preview mode.
PUBLIC_CONTACT_ENDPOINT=
# Google Maps key (Street View Static API) for the loader background. Restrict it to your domain.
PUBLIC_GOOGLE_MAPS_KEY=
# Optional: where catalogue data lives in production (persistent disk). Default: ./data
LQ_DATA_DIR=
PORT=4321
# Behind a TLS reverse proxy (needed at BUILD time, read by astro.config.mjs): the public
# hostnames whose forwarded Host/Proto/For headers Astro may trust, comma-separated.
# Without it the admin sees http://localhost and every admin POST is refused (403).
# Set it only if the proxy overwrites X-Forwarded-For (it becomes the login limiter key).
LQ_ALLOWED_DOMAINS=
# Force Secure on admin cookies when TLS ends at a proxy the app cannot see (1 = on).
LQ_COOKIE_SECURE=
# Maximum request size in MB (build time). Default 130: Misura sends up to 8 photos of 15 MB.
LQ_BODY_LIMIT_MB=
